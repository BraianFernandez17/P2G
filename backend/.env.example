# Copiá este archivo a ".env" y ajustá los valores si hace falta.
# Con el docker-compose.yml de Code P2G/ (o el de este backend), los
# valores de abajo ya funcionan tal cual.

PORT=3000
NODE_ENV=development

# Conexión a la misma base "polotec" que ya define Code P2G/docker-compose.yml
DATABASE_URL=postgresql://polotec:polotec@localhost:5432/polotec

# Secreto para firmar los JWT. En producción, generar uno largo y
# aleatorio (por ejemplo: openssl rand -hex 32) y NUNCA subirlo a git.
JWT_SECRET=cambiar-este-secreto-en-produccion
JWT_EXPIRES_IN=7d

# Orígenes permitidos para CORS (separados por coma). El frontend
# estático de "Code P2G/" se suele abrir con Live Server / file://.
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173
