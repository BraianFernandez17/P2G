// la pasantía y un botón real de "Postularme".
function verPasantia(pasantiaId) {
  const pasantia = pasantiasRecomendadas.find((p) => String(p.id) === String(pasantiaId));
  if (!pasantia) return;

  const yaPostulado = misPostulaciones.some((p) => p.titulo === pasantia.titulo);

  pedirConfirmacion(
    pasantia.titulo,
    `${pasantia.empresa} · ${pasantia.modalidad} · ${pasantia.duracionMeses} meses.` +
      (yaPostulado ? " Ya estás postulado a esta pasantía." : " ¿Querés postularte?"),
    yaPostulado ? null : () => postularme(pasantia),
    yaPostulado ? "Entendido" : "Postularme",
    yaPostulado ? null : "Cerrar"
  );
}

async function postularme(pasantia) {
  const sesion = obtenerSesion();
  if (!sesion || !sesion.studentId) {
    mostrarToast("Iniciá sesión como estudiante para postularte.", "error");
    return;
  }

  try {
    const respuesta = await fetch(`/api/internships/${pasantia.id}/applications`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ studentId: sesion.studentId }),
    });
    const datos = await respuesta.json();

    if (!respuesta.ok) {
      mostrarToast(datos.error || "No pudimos registrar la postulación.", "error");
      return;
    }

    misPostulaciones.push(datos);
    pintarMisPostulaciones();
    pintarEstadisticas();
    mostrarToast(`Te postulaste a "${pasantia.titulo}". Queda en revisión.`, "success");
  } catch {
    mostrarToast("No pudimos conectar con el servidor.", "error");
  }
}

