/* ============================================================
   DASHBOARD DE EMPRESA (mock)
   Mismo patrón que estudiante.js y reservas.js: datos de ejemplo
   a mano + funciones que pintan el HTML, para poder ver la
   pantalla funcionando sin backend todavía.
   ============================================================ */

// Rubros posibles de una empresa (mismo CHECK que companies.sector
// en db/schema.sql), con una etiqueta linda para mostrar en pantalla.
const ETIQUETA_SECTOR = {
  tecnologia: "Tecnología",
  industria: "Industria",
  agropecuaria: "Agropecuaria",
  comercio: "Comercio",
  servicios: "Servicios",
  educacion: "Educación",
  salud: "Salud",
  construccion: "Construcción",
  turismo: "Turismo",
  logistica: "Logística",
};

const ETIQUETA_ESTADO_POSTULANTE = {
  pending: "En revisión",
  approved: "Aprobado",
  rejected: "Rechazado",
};

// Ahora vienen de la API (ver server.js + db/schema.sql): arrancan
// vacías y se completan en cargarDatosEmpresa(), antes de pintar la
// pantalla (ver el punto de entrada al final del archivo).
let misPasantias = [];
let postulantesPorPasantia = {};

async function cargarDatosEmpresa() {
  const sesion = obtenerSesion();
  if (!sesion || !sesion.companyId) return;

  try {
    const respuesta = await fetch(`/api/internships?companyId=${sesion.companyId}`);
    misPasantias = await respuesta.json();

    // Postulantes de cada pasantía, para el detalle del modal y para
    // que las estadísticas del hub (postulantes nuevos, entrevistas
    // agendadas) salgan bien desde el primer pintado.
    for (const pasantia of misPasantias) {
      const postulantesRes = await fetch(`/api/internships/${pasantia.id}/applications`);
      postulantesPorPasantia[pasantia.id] = await postulantesRes.json();
    }
  } catch {
    mostrarToast("No pudimos conectar con el servidor.", "error");
  }
}

function pintarSaludoEmpresa() {
  const saludoEl = document.getElementById("saludo");
  if (!saludoEl) return;

  const sesion = obtenerSesion();
  const nombre = sesion ? sesion.name : "TechCorp Tacuarembó";
  saludoEl.textContent = `Hola, ${nombre}`;
}

// Muestra el rubro de la empresa como chip, al lado del saludo.
function pintarSectorEmpresa() {
  const sectorEl = document.getElementById("sector-empresa");
  if (!sectorEl) return;

  const sesion = obtenerSesion();
  const sector = sesion && sesion.sector ? sesion.sector : "servicios";
  sectorEl.textContent = ETIQUETA_SECTOR[sector] || sector;
}

// Número chico dentro de la tarjeta del hub (dashboard-empresa.html),
// para que la persona sepa qué la espera antes de entrar a Pasantías.
function pintarHubEmpresa() {
  const teaserPasantias = document.getElementById("teaser-pasantias");
  if (!teaserPasantias) return;

  const postulantesNuevos = Object.values(postulantesPorPasantia)
    .flat()
    .filter((p) => p.estado === "pending").length;

  teaserPasantias.innerHTML = `
    <span class="hub-option-teaser">📢 ${misPasantias.length} pasantías publicadas</span>
    <span class="hub-option-teaser">🧑‍🎓 ${postulantesNuevos} postulantes nuevos</span>
  `;
}

// Este banner es el mismo caso de "pending_approval" que ya
// describe schema.sql para companies: mientras el admin no
// apruebe la cuenta, se lo recordamos en vez de escondérselo.
function pintarAvisoPendiente() {
  const avisoEl = document.getElementById("aviso-pendiente");
  if (!avisoEl) return;

  const sesion = obtenerSesion();
  avisoEl.style.display =
    sesion && sesion.status === "pending_approval" ? "block" : "none";
}

// Antes estos tres números venían fijos a mano. Ahora "Pasantías
// publicadas", "Postulantes nuevos" y "Entrevistas agendadas" se
// calculan a partir de misPasantias y postulantesPorPasantia, así
// que se actualizan solos al publicar una pasantía nueva o al
// revisar postulantes.
function pintarEstadisticasEmpresa() {
  const grillaEl = document.getElementById("grilla-estadisticas");
  if (!grillaEl) return;

  const todosLosPostulantes = Object.values(postulantesPorPasantia).flat();
  const postulantesNuevos = todosLosPostulantes.filter((p) => p.estado === "pending").length;
  const entrevistasAgendadas = todosLosPostulantes.filter((p) => p.estado === "approved").length;

  const estadisticas = [
    { icono: "📢", tono: "accent", etiqueta: "Pasantías publicadas", valor: misPasantias.length },
    { icono: "🧑‍🎓", tono: "info", etiqueta: "Postulantes nuevos", valor: postulantesNuevos },
    { icono: "🗓️", tono: "success", etiqueta: "Entrevistas agendadas", valor: entrevistasAgendadas },
  ];

  grillaEl.innerHTML = estadisticas
    .map(
      (item) => `
      <div class="stat-card" data-tone="${item.tono}">
        <div class="stat-card-icon">${item.icono}</div>
        <p class="stat-card-label">${item.etiqueta}</p>
        <p class="stat-card-value">${item.valor}</p>
      </div>
    `
    )
    .join("");
}

/* ============================================================
   MIS PASANTÍAS (con filtro por modalidad, igual idea que el
   dashboard del estudiante)
   ============================================================ */
let filtroModalidadEmpresa = "todas";

function pintarFiltrosModalidadEmpresa() {
  const listaEl = document.getElementById("lista-pasantias");
  if (!listaEl) return;

  let filtrosEl = document.getElementById("filtros-modalidad-empresa");
  if (!filtrosEl) {
    filtrosEl = document.createElement("div");
    filtrosEl.id = "filtros-modalidad-empresa";
    filtrosEl.className = "filter-chips";
    listaEl.parentElement.insertBefore(filtrosEl, listaEl);
  }

  const modalidades = ["todas", ...new Set(misPasantias.map((p) => p.modalidad))];
  filtrosEl.innerHTML = modalidades
    .map(
      (modalidad) => `
      <button type="button" class="filter-chip ${filtroModalidadEmpresa === modalidad ? "active" : ""}" data-modalidad="${modalidad}">
        ${modalidad === "todas" ? "Todas" : modalidad}
      </button>
    `
    )
    .join("");

  filtrosEl.querySelectorAll("button[data-modalidad]").forEach((boton) => {
    boton.addEventListener("click", () => {
      filtroModalidadEmpresa = boton.dataset.modalidad;
      pintarMisPasantias();
    });
  });
}

function pintarMisPasantias() {
  const listaEl = document.getElementById("lista-pasantias");
  if (!listaEl) return;

  pintarFiltrosModalidadEmpresa();

  const pasantias =
    filtroModalidadEmpresa === "todas"
      ? misPasantias
      : misPasantias.filter((p) => p.modalidad === filtroModalidadEmpresa);

  if (pasantias.length === 0) {
    listaEl.innerHTML = `<p class="empty-state">Todavía no publicaste ninguna pasantía ${
      filtroModalidadEmpresa === "todas" ? "" : filtroModalidadEmpresa.toLowerCase()
    }.</p>`;
    return;
  }

  listaEl.innerHTML = pasantias
    .map((pasantia) => {
      const postulantes = postulantesPorPasantia[pasantia.id] || [];
      return `
      <div class="internship-card">
        <div>
          <p class="internship-title">${pasantia.titulo}</p>
          <p class="internship-meta">
            ${pasantia.modalidad} · ${pasantia.duracionMeses} meses · ${postulantes.length} postulante${postulantes.length === 1 ? "" : "s"}
          </p>
        </div>
        <button class="btn-view" data-pasantia-id="${pasantia.id}">Ver postulantes</button>
      </div>
    `;
    })
    .join("");

  listaEl.querySelectorAll("button[data-pasantia-id]").forEach((boton) => {
    boton.addEventListener("click", () => {
      verPostulantes(boton.dataset.pasantiaId);
    });
  });
}

/* ============================================================
   VER POSTULANTES (modal informativo, con detalle por candidato)
   ============================================================ */
function verPostulantes(pasantiaId) {
  const pasantia = misPasantias.find((p) => String(p.id) === String(pasantiaId));
  if (!pasantia) return;

  const postulantes = postulantesPorPasantia[pasantiaId] || [];

  if (postulantes.length === 0) {
    pedirConfirmacion(pasantia.titulo, "Todavía no tiene postulantes.", null, "Entendido", null);
    return;
  }

  const detalle = postulantes
    .map((p) => `${p.nombre} — ${ETIQUETA_ESTADO_POSTULANTE[p.estado]}`)
    .join("\n");

  pedirConfirmacion(`Postulantes: ${pasantia.titulo}`, detalle, null, "Cerrar", null);
}

/* ============================================================
   PUBLICAR PASANTÍA (formulario real, en vez del alert() de antes)
   ============================================================ */
function alternarFormularioPasantia() {
  const formulario = document.getElementById("form-nueva-pasantia");
  const boton = document.getElementById("publicar-pasantia");
  if (!formulario || !boton) return;

  const abierto = formulario.style.display !== "none";
  formulario.style.display = abierto ? "none" : "block";
  boton.textContent = abierto ? "Publicar pasantía" : "Cancelar";
  if (!abierto) {
    document.getElementById("pasantia-titulo").focus();
  }
}

async function manejarNuevaPasantia(evento) {
  evento.preventDefault();
  const formulario = evento.target;

  const titulo = formulario.querySelector("#pasantia-titulo").value.trim();
  const modalidad = formulario.querySelector("#pasantia-modalidad").value;
  const duracionMeses = Number(formulario.querySelector("#pasantia-duracion").value);

  if (!titulo || !modalidad || !duracionMeses) {
    mostrarToast("Completá todos los campos para publicar la pasantía.", "error");
    return;
  }

  const sesion = obtenerSesion();
  if (!sesion || !sesion.companyId) {
    mostrarToast("Iniciá sesión como empresa para publicar pasantías.", "error");
    return;
  }

  try {
    const respuesta = await fetch("/api/internships", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ companyId: sesion.companyId, titulo, modalidad, duracionMeses }),
    });
    const nuevaPasantia = await respuesta.json();

    if (!respuesta.ok) {
      mostrarToast(nuevaPasantia.error || "No pudimos publicar la pasantía.", "error");
      return;
    }

    misPasantias.push(nuevaPasantia);
    postulantesPorPasantia[nuevaPasantia.id] = [];

    formulario.reset();
    alternarFormularioPasantia();
    pintarMisPasantias();
    pintarEstadisticasEmpresa();
    mostrarToast(`"${titulo}" publicada. Ya es visible para los estudiantes.`, "success");
  } catch {
    mostrarToast("No pudimos conectar con el servidor.", "error");
  }
}

document.addEventListener("DOMContentLoaded", async () => {
  pintarSaludoEmpresa();
  pintarSectorEmpresa();
  pintarAvisoPendiente();

  await cargarDatosEmpresa();

  pintarHubEmpresa();
  pintarEstadisticasEmpresa();
  pintarMisPasantias();

  const botonPublicar = document.getElementById("publicar-pasantia");
  if (botonPublicar) botonPublicar.addEventListener("click", alternarFormularioPasantia);

  // El link "Publicar pasantía" del menú de arriba hace lo mismo que
  // el botón de la sección, pero además baja hasta el formulario:
  // si ya estaba abierto no lo cierra, solo lleva hasta ahí.
  const linkPublicar = document.getElementById("nav-publicar-pasantia");
  if (linkPublicar) {
    linkPublicar.addEventListener("click", (evento) => {
      evento.preventDefault();
      const formulario = document.getElementById("form-nueva-pasantia");
      if (formulario && formulario.style.display === "none") {
        alternarFormularioPasantia();
      }
      const seccion = document.getElementById("seccion-mis-pasantias");
      if (seccion) seccion.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  }

  const formNuevaPasantia = document.getElementById("form-nueva-pasantia");
  if (formNuevaPasantia) formNuevaPasantia.addEventListener("submit", manejarNuevaPasantia);
});

/* ============================================================
   SESIÓN (mock, con localStorage)
   Como todavía no hay backend, "iniciar sesión" acá no genera un
   JWT de verdad (ver sección 9 del documento técnico): guardamos
   un objeto simple en localStorage del navegador, que simula
   "quién soy y qué rol tengo" (mi cuenta). Es SOLO para que el
   mockup se sienta como una app real de principio a fin.

   En la versión con backend, esto se reemplaza por:
     - Guardar el JWT que devuelve POST /api/v1/auth/login
     - Mandar ese JWT en cada pedido (header Authorization)
     - Pedirle al backend "quién sos" en vez de leerlo de acá
   ============================================================ */

const CLAVE_SESION = "poloTecSesion";

// A qué panel va cada rol de cuenta una vez que inició sesión.
const PANEL_POR_ROL = {
  student: "dashboard-estudiante.html",
  company: "dashboard-empresa.html",
  professor: "dashboard-profesor.html",
  admin: "dashboard-admin.html",
};

// Nombre "bonito" de cada rol, para mostrar en la interfaz
// (navbar, saludo, distintivo de cuenta) en vez del código interno.
const NOMBRE_DEL_ROL = {
  student: "Estudiante",
  company: "Empresa",
  professor: "Profesor",
  admin: "Admin",
};

/* ------------------------------------------------------------
   Cuentas de ejemplo para probar el login (mismas de siempre,
   ver db/seed.sql): la contraseña de todas es "demo1234".
     maria@estudiante.com / facundo@estudiante.com   (estudiante)
     contacto@techcorp.com / rrhh@agrotacua.com.uy    (empresa activa)
     contacto@industriasnorte.com                      (empresa pendiente)
     ana@polotec.edu.uy / diego@polotec.edu.uy         (profesor)
     admin@polotec.edu.uy                              (admin)
   ------------------------------------------------------------ */

function guardarSesion(cuenta) {
  localStorage.setItem(CLAVE_SESION, JSON.stringify(cuenta));
}

function obtenerSesion() {
  const datos = localStorage.getItem(CLAVE_SESION);
  if (!datos) return null;
  try {
    return JSON.parse(datos);
  } catch {
    return null;
  }
}

function borrarSesion() {
  localStorage.removeItem(CLAVE_SESION);
}

// Se llama al principio de CADA dashboard (en un <script> chiquito
// en el <head>, antes de que se pinte el contenido). Si no hay
// sesión, o la sesión es de otro rol, manda derecho al login: así
// lo primero que ve alguien sin cuenta iniciada es siempre
// login/registro, nunca el contenido del panel.
function requerirRol(rolEsperado) {
  const sesion = obtenerSesion();
  if (!sesion || sesion.role !== rolEsperado) {
    window.location.href = "login.html";
    return null;
  }
  return sesion;
}

// Se llama en index.html: si ya hay sesión activa, en vez de
// mostrarle de nuevo la landing pública a alguien que ya se
// registró, lo manda directo a su panel.
function redirigirSiHaySesion() {
  const sesion = obtenerSesion();
  if (sesion && PANEL_POR_ROL[sesion.role]) {
    window.location.href = PANEL_POR_ROL[sesion.role];
  }
}

function cerrarSesion() {
  borrarSesion();
  window.location.href = "login.html";
}

/* ------------------------------------------------------------
   BOTÓN DE "CERRAR SESIÓN" Y DISTINTIVO DE ROL
   Todos los dashboards comparten el mismo botón (id="cerrar-sesion")
   y, si existe, un distintivo de rol (id="etiqueta-rol") en el
   navbar, así que los enganchamos acá una sola vez en vez de
   repetir el mismo código en cada página.
   ------------------------------------------------------------ */
document.addEventListener("DOMContentLoaded", () => {
  const botonCerrarSesion = document.getElementById("cerrar-sesion");
  if (botonCerrarSesion) {
    botonCerrarSesion.addEventListener("click", () => {
      cerrarSesion();
    });
  }

  const etiquetaRol = document.getElementById("etiqueta-rol");
  if (etiquetaRol) {
    const sesion = obtenerSesion();
    if (sesion && NOMBRE_DEL_ROL[sesion.role]) {
      etiquetaRol.textContent = NOMBRE_DEL_ROL[sesion.role];
    } else {
      etiquetaRol.style.display = "none";
    }
  }

  /* ------------------------------------------------------------
     BUSCADOR DEL MENÚ (genérico, para cualquier página)
     No hace falta escribir un buscador distinto por pantalla: con
     que la lista a filtrar tenga el atributo data-buscable en el
     contenedor (ej. <section id="lista-pasantias" data-buscable>),
     este único buscador filtra sus hijos por texto. Sirve tanto
     para tarjetas (pasantías, reservas, empresas) como para filas
     de tabla (agenda pública).
     ------------------------------------------------------------ */
  const buscadorGlobal = document.getElementById("buscador-global");
  if (buscadorGlobal) {
    buscadorGlobal.addEventListener("input", () => {
      const termino = buscadorGlobal.value.trim().toLowerCase();
      document.querySelectorAll("[data-buscable]").forEach((contenedor) => {
        Array.from(contenedor.children).forEach((item) => {
          const texto = item.textContent.toLowerCase();
          item.style.display = texto.includes(termino) ? "" : "none";
        });
      });
    });
  }

  /* ------------------------------------------------------------
     NAVEGACIÓN DEL MENÚ POR SECCIONES (genérico, para cualquier página)
     Los dashboards de estudiante, profesor y empresa son de una
     sola página con varias secciones, así que sus links del menú
     no tienen que ir a otro archivo: apuntan a una sección de la
     misma pantalla (ej. href="#seccion-mis-reservas").

     Con esto, esos links:
       1. hacen scroll suave hasta la sección correspondiente,
       2. y marcan solos cuál está activo según dónde estás parado
          al hacer scroll (clase .active, la misma que ya usaba el
          CSS para pintar el link distinto).

     Los links que apuntan a otro archivo (ej. agenda-publica.html)
     no se tocan: siguen navegando normal.
     ------------------------------------------------------------ */
  const linksDeSeccion = Array.from(
    document.querySelectorAll('.navbar nav .nav-link[href^="#"]')
  ).filter((link) => link.getAttribute("href").length > 1);

  if (linksDeSeccion.length > 0) {
    // Para cada link, guardamos la sección a la que apunta. Si un
    // link apunta a una sección que no existe en esta página, queda
    // afuera (así no rompe nada si se reordenan las secciones).
    const secciones = linksDeSeccion
      .map((link) => ({
        link,
        destino: document.querySelector(link.getAttribute("href")),
      }))
      .filter((par) => par.destino);

    if (secciones.length > 0) {
      secciones.forEach(({ link, destino }) => {
        link.addEventListener("click", (evento) => {
          evento.preventDefault();
          // scroll-margin-top en el CSS se encarga de que el título
          // no quede tapado por el navbar fijo.
          destino.scrollIntoView({ behavior: "smooth", block: "start" });
          linksDeSeccion.forEach((otro) => otro.classList.remove("active"));
          link.classList.add("active");
        });
      });

      // Marcar el link activo según la sección visible. Se recalcula
      // al hacer scroll: la sección "actual" es la última cuyo inicio
      // ya pasó por debajo del navbar.
      const marcarLinkActivo = () => {
        let actual = secciones[0];
        secciones.forEach((par) => {
          if (par.destino.getBoundingClientRect().top <= 120) actual = par;
        });
        linksDeSeccion.forEach((link) => {
          link.classList.toggle("active", link === actual.link);
        });
      };

      window.addEventListener("scroll", marcarLinkActivo, { passive: true });
      marcarLinkActivo();
    }
  }
});

/* ============================================================
   UI COMPARTIDA: TOASTS Y MODAL DE CONFIRMACIÓN
   Reemplazan a alert()/confirm() nativos por algo con la misma
   identidad visual del resto de la app. Vive en su propio archivo
   (en vez de repetirse en reservas.js, script.js y empresa.js)
   porque lo usan los tres: dashboard de estudiante, empresa,
   profesor y admin, más la agenda pública.

   Se inyectan una sola vez en el <body> la primera vez que hacen
   falta, así no hay que tocar cada HTML para tenerlos disponibles;
   con cargar este script alcanza.
   ============================================================ */
function asegurarContenedoresUI() {
  if (!document.getElementById("toast-container")) {
    const cont = document.createElement("div");
    cont.id = "toast-container";
    cont.className = "toast-container";
    document.body.appendChild(cont);
  }

  if (!document.getElementById("modal-overlay")) {
    const overlay = document.createElement("div");
    overlay.id = "modal-overlay";
    overlay.className = "modal-overlay";
    overlay.innerHTML = `
      <div class="modal" role="dialog" aria-modal="true">
        <p id="modal-titulo" class="modal-title"></p>
        <p id="modal-texto" class="modal-text"></p>
        <div class="modal-actions">
          <button id="modal-cancelar" type="button" class="btn-secondary">Cancelar</button>
          <button id="modal-confirmar" type="button" class="btn-primary">Confirmar</button>
        </div>
      </div>
    `;
    document.body.appendChild(overlay);
    overlay.addEventListener("click", (evento) => {
      if (evento.target === overlay) cerrarModal();
    });
  }
}

function mostrarToast(mensaje, tipo = "success") {
  asegurarContenedoresUI();
  const contenedor = document.getElementById("toast-container");

  const toast = document.createElement("div");
  toast.className = `toast toast-${tipo}`;
  const icono = { success: "✓", error: "✕", info: "i" }[tipo] || "✓";
  toast.innerHTML = `<span class="toast-icon">${icono}</span><span>${mensaje}</span>`;
  contenedor.appendChild(toast);

  setTimeout(() => {
    toast.classList.add("toast-saliendo");
    setTimeout(() => toast.remove(), 250);
  }, 3200);
}

function cerrarModal() {
  const overlay = document.getElementById("modal-overlay");
  if (overlay) overlay.classList.remove("visible");
}

// alConfirmar corre solo si la persona toca el botón de confirmar.
// textoConfirmar/textoCancelar dejan reusar el mismo modal tanto
// para confirmaciones destructivas ("Rechazar" / "Cancelar") como
// para diálogos informativos con una acción ("Postularme", "Ver
// postulantes"...), sin tener que escribir un modal por pantalla.
// Si se pasa textoCancelar = null, el botón de cancelar se oculta
// (para diálogos de solo información con un único botón de cierre).
function pedirConfirmacion(titulo, texto, alConfirmar, textoConfirmar = "Confirmar", textoCancelar = "Cancelar") {
  asegurarContenedoresUI();
  const overlay = document.getElementById("modal-overlay");
  document.getElementById("modal-titulo").textContent = titulo;
  document.getElementById("modal-texto").textContent = texto;
  overlay.classList.add("visible");

  const btnConfirmar = document.getElementById("modal-confirmar");
  const btnCancelar = document.getElementById("modal-cancelar");
  const nuevoConfirmar = btnConfirmar.cloneNode(true);
  btnConfirmar.replaceWith(nuevoConfirmar);
  const nuevoCancelar = btnCancelar.cloneNode(true);
  btnCancelar.replaceWith(nuevoCancelar);

  nuevoConfirmar.textContent = textoConfirmar;
  if (textoCancelar === null) {
    nuevoCancelar.style.display = "none";
  } else {
    nuevoCancelar.style.display = "";
    nuevoCancelar.textContent = textoCancelar;
  }

  nuevoConfirmar.addEventListener("click", () => {
    cerrarModal();
    if (alConfirmar) alConfirmar();
  });
  nuevoCancelar.addEventListener("click", cerrarModal);
}

/* ============================================================
   DATOS DEL DASHBOARD DEL ESTUDIANTE
   pasantiasRecomendadas y misPostulaciones ahora vienen de la API
   (ver server.js + db/schema.sql), no son datos escritos a mano.
   Arrancan vacíos y se completan en cargarDatosEstudiante(), que
   corre antes de pintar la pantalla (ver el punto de entrada al
   final del archivo).

   "porcentajePerfil" queda como estaba: es solo un indicador
   visual de la barra de perfil y el proyecto no pide guardar un
   porcentaje de completitud en la base de datos.
   ============================================================ */
const estudiante = {
  nombre: "María",
  porcentajePerfil: 70, // de 0 a 100
};

let pasantiasRecomendadas = [];
let misPostulaciones = [];

// Trae del backend las pasantías publicadas y las postulaciones
// del estudiante que inició sesión (si no hay sesión, se queda con
// las listas vacías: pasa cuando se abre el archivo directo, sin
// pasar por el login).
async function cargarDatosEstudiante() {
  try {
    const pasantiasRes = await fetch("/api/internships");
    pasantiasRecomendadas = await pasantiasRes.json();

    const sesion = obtenerSesion();
    if (sesion && sesion.studentId) {
      const postulacionesRes = await fetch(`/api/applications?studentId=${sesion.studentId}`);
      misPostulaciones = await postulacionesRes.json();
    }
  } catch {
    mostrarToast("No pudimos conectar con el servidor.", "error");
  }
}

const ETIQUETA_ESTADO_POSTULACION = {
  pending: "En revisión",
  approved: "Aprobada",
  rejected: "Rechazada",
};

/* ============================================================
   FUNCIONES QUE "PINTAN" CADA PARTE DE LA PÁGINA
   Cada una agarra un dato y lo mete adentro del HTML que ya
   existe (los elementos con id="..." que dejamos vacíos en
   dashboard-estudiante.html).
   ============================================================ */

function pintarSaludo() {
  const saludoEl = document.getElementById("saludo");
  if (!saludoEl) return;
  // Si hay una sesión real (se creó al iniciar sesión o registrarse,
  // ver js/sesion.js), usamos ese nombre. Si alguien abre este
  // archivo directo sin pasar por el login, mostramos el mock de
  // "María" para que la pantalla siga siendo demostrable.
  const sesion = obtenerSesion();
  const nombre = sesion ? sesion.name : estudiante.nombre;
  saludoEl.textContent = `Hola, ${nombre}`;
}

// Número chico dentro de la tarjeta del hub (dashboard-estudiante.html),
// para que la persona sepa qué la espera antes de entrar a Pasantías.
function pintarHubEstudiante() {
  const teaserPasantias = document.getElementById("teaser-pasantias");
  if (!teaserPasantias) return;

  const enRevision = misPostulaciones.filter((p) => p.estado === "pending").length;

  teaserPasantias.innerHTML = `
    <span class="hub-option-teaser">🎓 ${pasantiasRecomendadas.length} pasantías recomendadas</span>
    <span class="hub-option-teaser">📄 ${enRevision} postulaciones en revisión</span>
  `;
}

function pintarBarraDePerfil() {
  const fillEl = document.getElementById("barra-perfil-relleno");
  const porcentajeEl = document.getElementById("barra-perfil-porcentaje");
  if (!fillEl || !porcentajeEl) return;

  // Por las dudas, no dejamos que el valor se vaya de 0-100
  const porcentaje = Math.min(100, Math.max(0, estudiante.porcentajePerfil));

  fillEl.style.width = `${porcentaje}%`;
  porcentajeEl.textContent = `${porcentaje}%`;
}

// Antes estos tres números venían fijos a mano. Ahora "Postulaciones"
// y "En revisión" salen de misPostulaciones de verdad, así que se
// actualizan solos apenas alguien se postula desde el modal de abajo.
function pintarEstadisticas() {
  const grillaEl = document.getElementById("grilla-estadisticas");
  if (!grillaEl) return;

  const enRevision = misPostulaciones.filter((p) => p.estado === "pending").length;

  const estadisticas = [
