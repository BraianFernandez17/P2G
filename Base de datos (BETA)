/* ============================================================
   BACKEND MÍNIMO DEL PROYECTO
   Un solo archivo, con Express, que hace dos cosas:

     1. Sirve los archivos estáticos de la página (los mismos
        .html/.css/.js de siempre, sin tocarlos en su forma de
        servirse).
     2. Expone una API bajo /api que lee y escribe en Postgres,
        usando exactamente las tablas de db/schema.sql.

   No hay autenticación con tokens/JWT: como en el mock original,
   el navegador guarda en localStorage el "resultado" del login
   (ver js/sesion.js). La diferencia es que ahora ese resultado
   sale de una consulta real a la tabla users, no de un array
   escrito a mano.

   Cómo correrlo:
     1. docker compose up -d        (levanta Postgres + Adminer)
     2. npm install
     3. npm start
     4. abrir http://localhost:3000
   ============================================================ */
const express = require("express");
const crypto = require("crypto");
const pool = require("./db");

const app = express();
const PUERTO = process.env.PORT || 3000;

app.use(express.json());
app.use(express.static(__dirname));

/* ------------------------------------------------------------
   HASH DE CONTRASEÑAS
   Usamos scrypt (viene incluido en Node, no hace falta instalar
   nada) en vez de bcrypt para no sumar una dependencia más.
   Guardamos "salt:hash" en password_hash, que es exactamente el
   campo que ya define schema.sql.
   ------------------------------------------------------------ */
function hashearPassword(password) {
  const salt = crypto.randomBytes(16).toString("hex");
  const hash = crypto.scryptSync(password, salt, 64).toString("hex");
  return `${salt}:${hash}`;
}

function verificarPassword(password, passwordHash) {
  const [salt, hashGuardado] = String(passwordHash).split(":");
  if (!salt || !hashGuardado) return false;
  const hashIngresado = crypto.scryptSync(password, salt, 64).toString("hex");
  const bufferGuardado = Buffer.from(hashGuardado, "hex");
  const bufferIngresado = Buffer.from(hashIngresado, "hex");
  if (bufferGuardado.length !== bufferIngresado.length) return false;
  return crypto.timingSafeEqual(bufferGuardado, bufferIngresado);
}

// Atajo para no repetir el try/catch de "algo salió mal" en cada ruta.
function manejarError(res, error) {
  console.error(error);
  res.status(500).json({ error: "Error interno del servidor." });
}

/* ------------------------------------------------------------
   MODALIDAD: el <select> del formulario de pasantías usa
   "Remoto/Presencial/Híbrido" (ver dashboard-empresa-pasantias.html)
   pero internships.modality en la base es
   'remoto'/'presencial'/'hibrido' (ver schema.sql). Estas dos
   funciones convierten en cada sentido, sin tocar el HTML.
   ------------------------------------------------------------ */
const MODALIDAD_A_DB = { Remoto: "remoto", Presencial: "presencial", Híbrido: "hibrido" };
const MODALIDAD_A_ETIQUETA = { remoto: "Remoto", presencial: "Presencial", hibrido: "Híbrido" };

// Igual idea para el <select> de carrera del registro de estudiante
// (registro-estudiante.html), que usa slugs en vez del UUID real de
// courses.id.
const SLUG_A_CARRERA = {
  "tecnologo-informatica": "Tecnólogo en Informática",
  "tecnologo-mecanica": "Tecnólogo en Mecánica",
  "tecnologo-electronica": "Tecnólogo en Electrónica",
  "tecnologo-electromecanica": "Tecnólogo en Electromecánica",
  "tecnologo-quimico": "Tecnólogo Químico",
  "tecnologo-gestion-empresas": "Tecnólogo en Gestión de Empresas",
  "tecnicatura-analisis-desarrollo-software": "Tecnicatura en Análisis y Desarrollo de Software",
  "tecnicatura-administracion-contabilidad": "Tecnicatura en Administración y Contabilidad",
  "bachillerato-tecnologico-agrario": "Bachillerato Tecnológico Agrario",
  "bachillerato-tecnologico-turismo": "Bachillerato Tecnológico en Turismo",
};

// Los 6 estados de applications.status (ver schema.sql), bajados a
// los 3 que ya sabe pintar cada pantalla que NO es la del admin
// (dashboard-estudiante.html y dashboard-empresa-pasantias.html).
function estadoPostulacionSimplificado(estado) {
  if (estado === "selected") return "approved";
  if (estado === "rejected" || estado === "withdrawn") return "rejected";
  return "pending"; // submitted | under_review | shortlisted
}

/* ============================================================
   AUTENTICACIÓN
   ============================================================ */

// Arma el mismo objeto "cuenta" que antes vivía en CUENTAS_DEMO
// (js/sesion.js), a partir de una fila de users + su perfil.
async function armarCuenta(usuario) {
  const base = { id: usuario.id, email: usuario.email, role: usuario.role };

  if (usuario.role === "student") {
    const { rows } = await pool.query(
      "SELECT id, first_name, last_name FROM students WHERE user_id = $1",
      [usuario.id]
    );
    const estudiante = rows[0];
    return { ...base, studentId: estudiante?.id, name: `${estudiante?.first_name} ${estudiante?.last_name}` };
  }

  if (usuario.role === "company") {
    const { rows } = await pool.query(
      "SELECT id, legal_name, sector, status FROM companies WHERE user_id = $1",
      [usuario.id]
    );
    const empresa = rows[0];
    return {
      ...base,
      companyId: empresa?.id,
      name: empresa?.legal_name,
      sector: empresa?.sector,
      status: empresa?.status,
    };
  }

  if (usuario.role === "professor") {
    const { rows } = await pool.query(
      "SELECT id, first_name, last_name FROM professors WHERE user_id = $1",
      [usuario.id]
    );
    const profesor = rows[0];
    return { ...base, professorId: profesor?.id, name: `${profesor?.first_name} ${profesor?.last_name}` };
  }

  // Admin: no tiene tabla de perfil propia, es un único usuario del Polo.
  return { ...base, name: "Admin del Polo" };
}

app.post("/api/auth/login", async (req, res) => {
  try {
    const { email, password } = req.body;
    if (!email || !password) {
      return res.status(400).json({ error: "Falta email o contraseña." });
    }

    const { rows } = await pool.query("SELECT * FROM users WHERE email = $1", [
      email.toLowerCase(),
    ]);
    const usuario = rows[0];

    if (!usuario || !verificarPassword(password, usuario.password_hash)) {
      return res.status(401).json({ error: "No encontramos una cuenta con ese email y contraseña." });
    }

    res.json(await armarCuenta(usuario));
  } catch (error) {
    manejarError(res, error);
  }
});

app.post("/api/auth/register/student", async (req, res) => {
  const cliente = await pool.connect();
  try {
    const { nombre, apellido, email, carreraId, password } = req.body;
    if (!nombre || !apellido || !email || !carreraId || !password) {
      return res.status(400).json({ error: "Faltan datos del formulario." });
    }

    const nombreCarrera = SLUG_A_CARRERA[carreraId];
    const { rows: cursos } = await cliente.query("SELECT id FROM courses WHERE name = $1", [
      nombreCarrera,
    ]);
    if (cursos.length === 0) {
      return res.status(400).json({ error: "Carrera inválida." });
    }

    await cliente.query("BEGIN");
    const { rows: usuarios } = await cliente.query(
      "INSERT INTO users (email, password_hash, role) VALUES ($1, $2, 'student') RETURNING id",
      [email.toLowerCase(), hashearPassword(password)]
    );
    const userId = usuarios[0].id;
    await cliente.query(
      "INSERT INTO students (user_id, first_name, last_name, course_id) VALUES ($1, $2, $3, $4)",
      [userId, nombre, apellido, cursos[0].id]
    );
    await cliente.query("COMMIT");

    res.status(201).json({ role: "student", name: `${nombre} ${apellido}`, email });
  } catch (error) {
    await cliente.query("ROLLBACK");
    if (error.code === "23505") {
      return res.status(409).json({ error: "Ya existe una cuenta con ese email." });
    }
    manejarError(res, error);
  } finally {
    cliente.release();
  }
});

app.post("/api/auth/register/company", async (req, res) => {
  const cliente = await pool.connect();
  try {
    const { razonSocial, sector, email, password } = req.body;
    if (!razonSocial || !sector || !email || !password) {
      return res.status(400).json({ error: "Faltan datos del formulario." });
    }

    await cliente.query("BEGIN");
    const { rows: usuarios } = await cliente.query(
      "INSERT INTO users (email, password_hash, role) VALUES ($1, $2, 'company') RETURNING id",
      [email.toLowerCase(), hashearPassword(password)]
    );
    const userId = usuarios[0].id;
    await cliente.query(
      "INSERT INTO companies (user_id, legal_name, sector, status) VALUES ($1, $2, $3, 'pending_approval')",
      [userId, razonSocial, sector]
    );
    await cliente.query("COMMIT");

    res.status(201).json({
      role: "company",
      name: razonSocial,
      sector,
      email,
      status: "pending_approval",
    });
  } catch (error) {
    await cliente.query("ROLLBACK");
    if (error.code === "23505") {
      return res.status(409).json({ error: "Ya existe una cuenta con ese email." });
    }
    manejarError(res, error);
  } finally {
    cliente.release();
  }
});

app.post("/api/auth/register/professor", async (req, res) => {
  const cliente = await pool.connect();
  try {
    const { nombre, apellido, email, password } = req.body;
    if (!nombre || !apellido || !email || !password) {
      return res.status(400).json({ error: "Faltan datos del formulario." });
    }

    await cliente.query("BEGIN");
    const { rows: usuarios } = await cliente.query(
      "INSERT INTO users (email, password_hash, role) VALUES ($1, $2, 'professor') RETURNING id",
      [email.toLowerCase(), hashearPassword(password)]
    );
    const userId = usuarios[0].id;
    await cliente.query(
      "INSERT INTO professors (user_id, first_name, last_name) VALUES ($1, $2, $3)",
      [userId, nombre, apellido]
    );
    await cliente.query("COMMIT");

    res.status(201).json({ role: "professor", name: `${nombre} ${apellido}`, email });
  } catch (error) {
    await cliente.query("ROLLBACK");
    if (error.code === "23505") {
      return res.status(409).json({ error: "Ya existe una cuenta con ese email." });
    }
    manejarError(res, error);
  } finally {
    cliente.release();
  }
});

