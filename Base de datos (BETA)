// Nombre completo de quien pidió la reserva, sea profesor o admin.
async function nombreDeUsuario(userId) {
  const { rows } = await pool.query(
    `SELECT u.role,
            p.first_name AS p_first, p.last_name AS p_last
       FROM users u
       LEFT JOIN professors p ON p.user_id = u.id
      WHERE u.id = $1`,
    [userId]
  );
  const fila = rows[0];
  if (!fila) return "";
  if (fila.role === "professor") return `${fila.p_first} ${fila.p_last}`;
  return "Admin del Polo";
}

function filaAReserva(fila, userIdActual) {
  return {
    id: fila.id,
    salonId: fila.resource_id,
    motivo: fila.title,
    desde: fila.starts_at.toISOString().slice(0, 19),
    hasta: fila.ends_at.toISOString().slice(0, 19),
    estado: fila.status,
    pedidaPor: fila.pedida_por,
    esMia: userIdActual ? fila.requested_by === userIdActual : false,
    relacionConPostulacionId: fila.related_application_id,
  };
}

app.get("/api/bookings", async (req, res) => {
  try {
    const { rows } = await pool.query(`
      SELECT b.*,
             COALESCE(p.first_name || ' ' || p.last_name, 'Admin del Polo') AS pedida_por
        FROM bookings b
        JOIN users u ON u.id = b.requested_by
        LEFT JOIN professors p ON p.user_id = u.id
       ORDER BY b.starts_at
    `);
    res.json(rows.map((fila) => filaAReserva(fila, req.query.userId)));
  } catch (error) {
    manejarError(res, error);
  }
});

app.post("/api/bookings", async (req, res) => {
  try {
    const { resourceId, motivo, desde, hasta, requestedBy, relatedApplicationId } = req.body;
    if (!resourceId || !motivo || !desde || !hasta || !requestedBy) {
      return res.status(400).json({ error: "Faltan datos de la reserva." });
    }

    // La reserva de una entrevista (agendarEntrevista) la pide el
    // admin y nace directamente aprobada; el resto nace "pending",
    // igual que en el mock original.
    const estadoInicial = relatedApplicationId ? "approved" : "pending";

    const { rows } = await pool.query(
      `INSERT INTO bookings (resource_id, requested_by, title, starts_at, ends_at, status, related_application_id)
       VALUES ($1, $2, $3, $4, $5, $6, $7)
       RETURNING *`,
      [resourceId, requestedBy, motivo, desde, hasta, estadoInicial, relatedApplicationId || null]
    );

    const pedidaPor = await nombreDeUsuario(requestedBy);
    res.status(201).json(filaAReserva({ ...rows[0], pedida_por: pedidaPor }, requestedBy));
  } catch (error) {
    // El EXCLUDE constraint de schema.sql (no_solapamiento_de_horarios)
    // rechaza el INSERT con este código si el horario ya está ocupado.
    if (error.code === "23P01") {
      return res.status(409).json({ error: "Ese salón ya tiene otra reserva en ese horario." });
    }
    manejarError(res, error);
  }
});

app.patch("/api/bookings/:id", async (req, res) => {
  try {
    const { status } = req.body;
    const estadosValidos = ["pending", "approved", "rejected", "cancelled"];
    if (!estadosValidos.includes(status)) {
      return res.status(400).json({ error: "Estado inválido." });
    }

    const { rows } = await pool.query(
      "UPDATE bookings SET status = $1 WHERE id = $2 RETURNING id",
      [status, req.params.id]
    );
    if (rows.length === 0) return res.status(404).json({ error: "Reserva no encontrada." });

    res.json({ ok: true });
  } catch (error) {
    manejarError(res, error);
  }
});

