/* ============================================================
   CONEXIÓN A LA BASE DE DATOS (Postgres)
   Usa las mismas credenciales que ya define docker-compose.yml
   (POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB = polotec), así que
   con "docker compose up -d" + "npm start" alcanza para tener todo
   funcionando, sin configurar nada más.

   Si en algún momento la base vive en otro lado (por ejemplo, un
   servidor de verdad en vez de la máquina local), alcanza con
   definir la variable de entorno DATABASE_URL y esta la usa en
   vez de los valores por defecto de abajo.
   ============================================================ */
const { Pool } = require("pg");

const pool = process.env.DATABASE_URL
  ? new Pool({ connectionString: process.env.DATABASE_URL })
  : new Pool({
      host: process.env.PGHOST || "localhost",
      port: Number(process.env.PGPORT) || 5432,
      user: process.env.PGUSER || "polotec",
      password: process.env.PGPASSWORD || "polotec",
      database: process.env.PGDATABASE || "polotec",
    });

module.exports = pool;

