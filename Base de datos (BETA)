# ============================================================
# docker-compose.yml
# Levanta, con un solo comando, todo lo necesario para tener la
# base de datos funcionando: Postgres + una interfaz web (Adminer)
# para mirar las tablas sin instalar nada más en la máquina.
#
# Cómo usarlo:
#   1. Instalar Docker Desktop (gratis): https://www.docker.com/products/docker-desktop/
#   2. Pararse en esta carpeta (codigo-base-fundamentos/) y correr:
#        docker compose up -d
#   3. La primera vez que se crea el volumen, Postgres ejecuta
#      automáticamente, en orden alfabético, todo lo que haya en
#      /docker-entrypoint-initdb.d/: primero db/schema.sql
#      (crea las tablas) y después db/seed.sql (carga los datos
#      de prueba). Si ya existía el volumen de una corrida
#      anterior, NO se vuelven a ejecutar (ver más abajo cómo
#      resetear si hace falta).
#   4. Adminer queda en http://localhost:8080
#        Sistema: PostgreSQL
#        Servidor: db
#        Usuario:  polotec
#        Contraseña: polotec
#        Base de datos: polotec
#   5. Para conectarse por terminal en vez de por Adminer:
#        docker exec -it polotec-db psql -U polotec -d polotec
#
# Para borrar todo y volver a arrancar de cero (por ejemplo, si
# se edita schema.sql o seed.sql y hay que recargarlos):
#   docker compose down -v
#   docker compose up -d
# ============================================================

services:
  db:
    image: postgres:16
    container_name: polotec-db
    restart: unless-stopped
    environment:
      POSTGRES_USER: polotec
      POSTGRES_PASSWORD: polotec
      POSTGRES_DB: polotec
    ports:
      - "5432:5432"
    volumes:
      - polotec-db-data:/var/lib/postgresql/data
      - ./db/schema.sql:/docker-entrypoint-initdb.d/01-schema.sql:ro
      - ./db/seed.sql:/docker-entrypoint-initdb.d/02-seed.sql:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U polotec -d polotec"]
      interval: 5s
      timeout: 5s
      retries: 5

  adminer:
    image: adminer
    container_name: polotec-adminer
    restart: unless-stopped
    ports:
      - "8080:8080"
    depends_on:
      - db

volumes:
  polotec-db-data:

