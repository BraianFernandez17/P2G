async function manejarNuevaReserva(evento) {
  evento.preventDefault();
  const formulario = evento.target;

  const salonId = formulario.querySelector("#salon").value;
  const motivo = formulario.querySelector("#reserva-motivo").value.trim();
  const fecha = formulario.querySelector("#reserva-fecha").value;
  const horaDesde = formulario.querySelector("#reserva-desde").value;
  const horaHasta = formulario.querySelector("#reserva-hasta").value;

  if (!salonId || !motivo || !fecha || !horaDesde || !horaHasta) {
    mostrarToast("Completá todos los campos para pedir la reserva.", "error");
    return;
  }

  const desde = `${fecha}T${horaDesde}:00`;
  const hasta = `${fecha}T${horaHasta}:00`;

  if (new Date(hasta) <= new Date(desde)) {
    mostrarToast("La hora de fin tiene que ser posterior a la hora de inicio.", "error");
    return;
  }

  if (haySolapamiento(salonId, desde, hasta, null)) {
    mostrarToast(
      `Ya hay otra reserva para ${nombreDelSalon(salonId)} que se solapa con ese horario.`,
      "error"
    );
    return;
  }

  const sesion = typeof obtenerSesion === "function" ? obtenerSesion() : null;
  if (!sesion || !sesion.id) {
    mostrarToast("Iniciá sesión como profesor para pedir una reserva.", "error");
    return;
  }

  try {
    const respuesta = await fetch("/api/bookings", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ resourceId: salonId, motivo, desde, hasta, requestedBy: sesion.id }),
    });
    const datos = await respuesta.json();

    if (!respuesta.ok) {
      // Si dos personas piden el mismo horario al mismo tiempo, la
      // verdad absoluta la tiene el EXCLUDE constraint de Postgres
      // (ver db/schema.sql), no el chequeo de arriba hecho en el
      // navegador: por eso este caso también hay que manejarlo acá.
      mostrarToast(datos.error || "No pudimos guardar la reserva.", "error");
      return;
    }

    reservas.push(datos);
    formulario.reset();
    pintarMisReservas();
    mostrarToast("Reserva enviada. Queda pendiente de aprobación del admin.", "success");
  } catch {
    mostrarToast("No pudimos conectar con el servidor.", "error");
  }
}

