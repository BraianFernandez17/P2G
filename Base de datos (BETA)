      const textoOcupacion = salon.cantidad
        ? `${salon.cantidad} unidades`
        : proximas > 0
        ? `${proximas} reserva${proximas === 1 ? "" : "s"} próxima${proximas === 1 ? "" : "s"}`
        : "Sin reservas próximas";

      return `
      <div class="inventory-card">
