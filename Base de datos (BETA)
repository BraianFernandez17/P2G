const ETIQUETA_ESTADO = {
  pending: "Pendiente",
  approved: "Aprobada",
  rejected: "Rechazada",
  cancelled: "Cancelada",
};

function nombreDelSalon(salonId) {
  const salon = salones.find((s) => s.id === salonId);
  return salon ? salon.nombre : "Salón";
}

// Convierte "2026-08-05T14:00:00" / "2026-08-05T16:00:00" en algo
// legible tipo "05/08 · 14:00 a 16:00", sin depender de librerías.
function formatearRango(desde, hasta) {
  const inicio = new Date(desde);
  const fin = new Date(hasta);

  const pad = (n) => String(n).padStart(2, "0");
  const etiquetaFecha = `${pad(inicio.getDate())}/${pad(inicio.getMonth() + 1)}`;
  const horaInicio = `${pad(inicio.getHours())}:${pad(inicio.getMinutes())}`;
  const horaFin = `${pad(fin.getHours())}:${pad(fin.getMinutes())}`;

  return `${etiquetaFecha} · ${horaInicio} a ${horaFin}`;
}

function chipDeEstado(estado) {
  return `<span class="status-badge ${estado}">${ETIQUETA_ESTADO[estado]}</span>`;
}

/* ============================================================
   VALIDACIÓN DE SOLAPAMIENTO (solo un aviso del lado del cliente)
   OJO: esto es nada más que una ayuda visual para que la persona
   no llene el formulario en vano. La verdad absoluta la tiene el
   EXCLUDE constraint de Postgres (ver schema.sql): si dos
   pedidos llegan al mismo tiempo, el backend es quien decide, no
   este chequeo hecho en el navegador.
   ============================================================ */
function haySolapamiento(salonId, desde, hasta, idAExcluir) {
  const nuevoInicio = new Date(desde).getTime();
  const nuevoFin = new Date(hasta).getTime();

  return reservas.some((reserva) => {
    if (reserva.id === idAExcluir) return false;
    if (reserva.salonId !== salonId) return false;
    if (reserva.estado !== "pending" && reserva.estado !== "approved") return false;

    const inicioExistente = new Date(reserva.desde).getTime();
    const finExistente = new Date(reserva.hasta).getTime();

    return nuevoInicio < finExistente && nuevoFin > inicioExistente;
  });
}

/* ============================================================
   AVISO DE DISPONIBILIDAD EN VIVO
   Mejora al formulario de reserva: en vez de que la persona se
   entere de un choque de horario recién al enviar, se lo mostramos
   apenas completa salón + fecha + horario. Sigue siendo solo un
   aviso del lado del cliente (misma lógica que haySolapamiento);
   la validación real sigue pasando en manejarNuevaReserva.
   ============================================================ */
function inicializarChequeoDisponibilidad() {
  const formulario = document.getElementById("form-nueva-reserva");
  if (!formulario) return;

  let hintEl = document.getElementById("disponibilidad-hint");
  if (!hintEl) {
    hintEl = document.createElement("p");
    hintEl.id = "disponibilidad-hint";
    hintEl.className = "availability-hint";
    const boton = formulario.querySelector("button[type=submit]");
    formulario.insertBefore(hintEl, boton);
  }

  const idsCampos = ["salon", "reserva-fecha", "reserva-desde", "reserva-hasta"];
  const campos = idsCampos.map((id) => document.getElementById(id));

  function actualizarAviso() {
    const [salonEl, fechaEl, desdeEl, hastaEl] = campos;
    const salonId = salonEl.value;
    const fecha = fechaEl.value;
    const horaDesde = desdeEl.value;
    const horaHasta = hastaEl.value;

    if (!salonId || !fecha || !horaDesde || !horaHasta) {
      hintEl.className = "availability-hint";
      hintEl.textContent = "";
      return;
    }

    const desde = `${fecha}T${horaDesde}:00`;
    const hasta = `${fecha}T${horaHasta}:00`;

    if (new Date(hasta) <= new Date(desde)) {
      hintEl.className = "availability-hint busy";
      hintEl.textContent = "⚠ La hora de fin tiene que ser posterior a la de inicio.";
      return;
    }

    if (haySolapamiento(salonId, desde, hasta, null)) {
      hintEl.className = "availability-hint busy";
      hintEl.textContent = `⚠ ${nombreDelSalon(salonId)} ya tiene otra reserva en ese horario.`;
    } else {
      hintEl.className = "availability-hint free";
      hintEl.textContent = `✓ ${nombreDelSalon(salonId)} está disponible en ese horario.`;
    }
  }

  campos.forEach((campo) => campo && campo.addEventListener("change", actualizarAviso));
  formulario.addEventListener("reset", () => {
    setTimeout(() => {
      hintEl.className = "availability-hint";
      hintEl.textContent = "";
    }, 0);
  });
}

