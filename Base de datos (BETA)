async function agendarEntrevista(entrevista) {
  // Por simplicidad del mock, la entrevista queda fija para
  // dentro de 2 días de 15:00 a 15:45 en la Sala de Conferencias.
  // En la versión real, un formulario le dejaría elegir fecha y hora.
  const salaDeConferencias = salones.find((s) => s.nombre === "Sala de Conferencias");
  if (!salaDeConferencias) {
    mostrarToast("No encontramos la Sala de Conferencias en el inventario.", "error");
    return;
  }

  const inicio = new Date();
  inicio.setDate(inicio.getDate() + 2);
  inicio.setHours(15, 0, 0, 0);
  const fin = new Date(inicio);
  fin.setMinutes(45);

  const desde = inicio.toISOString().slice(0, 19);
  const hasta = fin.toISOString().slice(0, 19);

  if (haySolapamiento(salaDeConferencias.id, desde, hasta, null)) {
    mostrarToast("La Sala de Conferencias ya tiene otra reserva en ese horario.", "error");
    return;
  }

  const sesion = typeof obtenerSesion === "function" ? obtenerSesion() : null;
  if (!sesion || !sesion.id) {
    mostrarToast("Iniciá sesión como admin para agendar la entrevista.", "error");
    return;
  }

  try {
    const respuesta = await fetch("/api/bookings", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        resourceId: salaDeConferencias.id,
        motivo: `Entrevista: ${entrevista.nombreEstudiante} (${entrevista.nombreEmpresa})`,
        desde,
        hasta,
        requestedBy: sesion.id,
        relatedApplicationId: entrevista.id,
      }),
    });
    const datos = await respuesta.json();

    if (!respuesta.ok) {
      mostrarToast(datos.error || "No pudimos agendar la entrevista.", "error");
      return;
    }

    reservas.push(datos);
    entrevista.agendada = true;

    pintarEntrevistasPorAgendar();
    pintarAgendaPublica();
    pintarEstadisticasReservas();
    pintarInventarioDeSalones();
    pintarResumenPasantias();
    mostrarToast(
      `Sala de Conferencias reservada para la entrevista de ${entrevista.nombreEstudiante}.`,
      "success"
    );
  } catch {
    mostrarToast("No pudimos conectar con el servidor.", "error");
  }
}

// Inventario de salones agrupado por tipo: cumple el pedido de la
