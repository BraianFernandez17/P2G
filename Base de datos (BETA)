.profile-bar {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 24px;
}

.profile-bar-label {
  font-size: 13px;
  color: var(--color-text-secondary);
  white-space: nowrap;
}

.profile-bar-track {
  width: 180px;
  height: 8px;
  background: var(--color-background);
  border-radius: 999px;
  overflow: hidden;
  box-shadow: inset 0 1px 2px rgba(18, 49, 79, 0.08);
}

/* El ancho de esta barra lo define JS en tiempo real (style="width: X%"),
   por eso acá solo declaramos el color y la transición suave */
.profile-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--color-accent), var(--color-accent-light));
  border-radius: 999px;
  transition: width 0.6s var(--transition-base);
}

/* ============================================================
   TARJETAS DE MÉTRICAS (stats)
   Cada tarjeta puede llevar un ícono circular de color (definido
   por JS con data-tone="accent|success|warning|info|danger") para
   diferenciar de un vistazo qué tipo de métrica es.
   ============================================================ */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-bottom: 28px;
}

.stat-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  padding: 16px;
  box-shadow: var(--shadow-sm);
  transition: transform var(--transition-base), box-shadow var(--transition-base);
  animation: fadeInUp 0.45s var(--transition-base) both;
}

.stat-card:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow-md);
}

.stat-card-icon {
  width: 32px;
  height: 32px;
  border-radius: 9px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 15px;
  margin-bottom: 10px;
  background: var(--color-accent);
  color: white;
}

.stat-card[data-tone="accent"] .stat-card-icon { background: var(--color-accent); }
.stat-card[data-tone="success"] .stat-card-icon { background: var(--color-success); }
.stat-card[data-tone="warning"] .stat-card-icon { background: var(--color-warning); }
.stat-card[data-tone="info"] .stat-card-icon { background: var(--color-info); }
.stat-card[data-tone="danger"] .stat-card-icon { background: var(--color-danger); }
.stat-card[data-tone="primary"] .stat-card-icon { background: var(--color-primary); }

.stat-card-label {
  font-size: 12.5px;
  color: var(--color-text-secondary);
  margin-bottom: 2px;
}

.stat-card-value {
  font-size: 24px;
  font-weight: 800;
  letter-spacing: -0.02em;
}

/* ============================================================
   LISTADO DE PASANTÍAS
   ============================================================ */
.section-title {
  font-size: 14px;
  font-weight: 800;
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--color-primary);
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.section-hint {
  font-size: 12.5px;
  font-weight: 400;
  text-transform: none;
  letter-spacing: normal;
  color: var(--color-text-secondary);
  margin: -8px 0 12px;
}

.internship-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 28px;
}

.internship-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  padding: 14px 16px;
  background: var(--color-surface);
  transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
  animation: fadeInUp 0.4s var(--transition-base) both;
}

.internship-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
  border-color: var(--color-accent-light);
}

.internship-title {
  font-weight: 700;
  margin-bottom: 3px;
}

.internship-meta {
  font-size: 13px;
  color: var(--color-text-secondary);
}

.btn-view {
  background: none;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  padding: 7px 16px;
  font-size: 13px;
  font-weight: 700;
  color: var(--color-text);
  cursor: pointer;
  flex-shrink: 0;
  transition: background var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
}

.btn-view:hover {
  background: var(--color-background);
  border-color: var(--color-accent);
  transform: translateY(-1px);
}

/* ============================================================
   NAVBAR PÚBLICA (la que ve alguien que todavía no inició sesión)
   ============================================================ */
.navbar-public {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 28px;
  background: rgba(255, 255, 255, 0.78);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--color-border);
  position: sticky;
  top: 0;
  z-index: 10;
}

.navbar-public .logo {
  color: var(--color-primary);
}

.navbar-public-actions {
  display: flex;
  align-items: center;
  gap: 14px;
}

/* ============================================================
   BARRA DE BÚSQUEDA DEL MENÚ
   Un único input reutilizable (id="buscador-global") que vive en
   cualquier navbar. sesion.js lo engancha automáticamente: filtra
   cualquier lista marcada con data-buscable que haya en la misma
   página (pasantías, reservas, empresas, filas de la agenda...),
   sin que cada página tenga que escribir su propio buscador.
   ============================================================ */
.navbar-search {
  display: flex;
  align-items: center;
  gap: 8px;
  background: var(--color-background);
  border: 1px solid var(--color-border);
  border-radius: 999px;
  padding: 8px 14px;
  width: 220px;
  transition: width var(--transition-base), border-color var(--transition-fast), box-shadow var(--transition-fast);
}

.navbar-search:focus-within {
  width: 260px;
  border-color: var(--color-accent);
  box-shadow: 0 0 0 3px rgba(14, 131, 136, 0.12);
}

.navbar-search svg {
  flex-shrink: 0;
  color: var(--color-text-secondary);
}

.navbar-search input {
  border: none;
  background: none;
  outline: none;
  font-size: 13.5px;
  font-family: inherit;
  color: var(--color-text);
  width: 100%;
}

.navbar-search input::placeholder {
  color: var(--color-text-secondary);
}

/* ============================================================
   BOTONES GENÉRICOS
   .btn-primary: la acción principal de cada pantalla (1 por pantalla)
   .btn-secondary: una acción secundaria, menos "gritada" visualmente
   ============================================================ */
.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  background: var(--color-primary);
  background-image: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: var(--color-surface);
  border: none;
  border-radius: var(--radius-sm);
  padding: 11px 22px;
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
  text-decoration: none;
  text-align: center;
  box-shadow: var(--shadow-sm);
  transition: transform var(--transition-fast), box-shadow var(--transition-fast), opacity var(--transition-fast);
}

.btn-primary:hover {
  transform: translateY(-1px);
  box-shadow: var(--shadow-md);
}

.btn-primary:active {
  transform: translateY(0);
}

.btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  background: var(--color-surface);
  color: var(--color-primary);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  padding: 11px 22px;
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
  text-decoration: none;
  text-align: center;
  transition: background var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
}

.btn-secondary:hover {
  background: var(--color-background);
  border-color: var(--color-accent);
  transform: translateY(-1px);
}

.btn-block {
  width: 100%;
}

/* ============================================================
   HERO (la sección grande de bienvenida en la página de inicio)
   Fondo degradé navy → teal, con un halo circular sutil detrás
   del título para darle profundidad sin recargar la pantalla.
   ============================================================ */
.hero {
  position: relative;
  text-align: center;
  padding: 76px 20px 60px;
  color: white;
  background: var(--gradient-brand);
  overflow: hidden;
}

.hero::before {
  content: "";
  position: absolute;
  width: 480px;
  height: 480px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(20, 173, 166, 0.35), transparent 70%);
  top: -220px;
  right: -140px;
  pointer-events: none;
  animation: floatSlow 8s ease-in-out infinite;
}

.hero-inner {
  position: relative;
  max-width: 640px;
  margin: 0 auto;
}

.hero-eyebrow {
  display: inline-block;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #9FE7E3;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 999px;
  padding: 5px 14px;
  margin-bottom: 18px;
}

.hero-title {
  font-size: 32px;
  font-weight: 800;
  letter-spacing: -0.02em;
  margin-bottom: 14px;
  animation: fadeInUp 0.6s var(--transition-base) both;
}

.hero-subtitle {
  font-size: 15px;
  color: rgba(255, 255, 255, 0.82);
  margin-bottom: 30px;
  animation: fadeInUp 0.6s var(--transition-base) 0.08s both;
}

.hero-actions {
  display: flex;
  justify-content: center;
  gap: 12px;
  animation: fadeInUp 0.6s var(--transition-base) 0.16s both;
}

.hero .btn-secondary {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.35);
  color: white;
}

.hero .btn-secondary:hover {
  background: rgba(255, 255, 255, 0.16);
}

.hero .btn-primary {
  background: white;
  background-image: none;
  color: var(--color-primary);
}

.hero .btn-primary:hover {
  background: #F0F4F8;
}

/* ============================================================
   TARJETAS DE ROL (Soy estudiante / Soy empresa / Soy profesor)
   ============================================================ */
.role-cards {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
  max-width: 720px;
  margin: -30px auto 64px;
  padding: 0 20px;
  position: relative;
}

.role-card {
  position: relative;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 26px 22px;
  text-align: center;
  box-shadow: var(--shadow-md);
  transition: transform var(--transition-base), box-shadow var(--transition-base);
  animation: fadeInUp 0.5s var(--transition-base) both;
}

.role-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 22px;
  right: 22px;
  height: 3px;
  border-radius: 0 0 4px 4px;
  background: var(--color-accent);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform var(--transition-base);
}

.role-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-lg);
}

.role-card:hover::before {
  transform: scaleX(1);
}

.role-card-icon {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: var(--color-background);
  color: var(--color-accent);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 14px;
  font-size: 20px;
}

.role-card-title {
  font-weight: 800;
  margin-bottom: 6px;
  color: var(--color-primary);
}

.role-card-text {
  font-size: 13px;
  color: var(--color-text-secondary);
  margin-bottom: 18px;
  line-height: 1.5;
}

/* ============================================================
   TARJETA DE AUTENTICACIÓN (login y registro)
   ============================================================ */
.auth-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-background);
  background-image:
    radial-gradient(circle at 15% 15%, rgba(14, 131, 136, 0.08), transparent 45%),
    radial-gradient(circle at 85% 85%, rgba(18, 49, 79, 0.06), transparent 45%);
  padding: 20px;
}

.auth-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 36px 32px;
  width: 100%;
  max-width: 400px;
  box-shadow: var(--shadow-lg);
  animation: fadeInUp 0.4s var(--transition-base) both;
}


.auth-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  text-align: center;
  font-weight: 800;
  color: var(--color-primary);
  margin-bottom: 6px;
  letter-spacing: -0.02em;
}

.auth-logo img {
  height: 30px;
  width: auto;
  display: block;
}

.auth-title {
  text-align: center;
  font-size: 19px;
  font-weight: 800;
  margin-bottom: 26px;
  color: var(--color-primary);
}

/* ============================================================
   CAMPOS DE FORMULARIO
   ============================================================ */
.form-group {
  margin-bottom: 16px;
}

.form-label {
  display: block;
  font-size: 13px;
  font-weight: 700;
  margin-bottom: 6px;
  color: var(--color-text);
}

.form-input,
.form-select {
  width: 100%;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  padding: 10px 12px;
  font-size: 14px;
  font-family: inherit;
  color: var(--color-text);
  background: var(--color-surface);
  transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
}

.form-input:focus,
.form-select:focus {
  outline: none;
  border-color: var(--color-accent);
  box-shadow: 0 0 0 3px rgba(14, 131, 136, 0.15);
}

.form-hint {
  font-size: 12px;
  color: var(--color-text-secondary);
  margin-top: 4px;
}

/* Mensaje de error chiquito debajo de un campo. Arranca oculto
   (display: none) y JS lo muestra solo si hace falta. */
.form-error {
  display: none;
  font-size: 12px;
  color: var(--color-danger);
  margin-top: 4px;
  animation: fadeIn 0.2s ease both;
}

.form-error.visible {
  display: block;
}

.auth-footer {
  text-align: center;
  font-size: 13px;
  color: var(--color-text-secondary);
  margin-top: 22px;
  line-height: 1.6;
}

.auth-footer a {
  color: var(--color-accent);
  font-weight: 700;
  text-decoration: none;
}

.auth-footer a:hover {
  text-decoration: underline;
}

.auth-demo-box {
  margin-top: 18px;
  padding: 10px 12px;
  background: var(--color-background);
  border: 1px dashed var(--color-border);
  border-radius: var(--radius-sm);
  font-size: 12px;
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.6;
}

/* ============================================================
   TARJETAS DE ROL: VARIANTE DE 3 COLUMNAS
   ============================================================ */
.role-cards-three {
  grid-template-columns: repeat(3, 1fr);
}

/* ============================================================
   BADGES DE ESTADO (reservas y postulaciones)
   Mismo semáforo pending/approved/rejected/cancelled que ya
   usa el módulo de pasantías, pintado acá como una "pastillita"
   de color con un puntito, para leerse de un vistazo.
   ============================================================ */
.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  font-weight: 700;
  padding: 4px 12px;
  border-radius: 999px;
  white-space: nowrap;
}

.status-badge::before {
  content: "";
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: currentColor;
}

.status-badge.pending {
  background: var(--color-warning-bg);
  color: var(--color-warning);
}

.status-badge.pending::before {
  animation: pulseDot 1.6s ease-in-out infinite;
}

.status-badge.approved {
  background: var(--color-success-bg);
  color: var(--color-success);
}

.status-badge.rejected {
  background: var(--color-danger-bg);
  color: var(--color-danger);
}

.status-badge.cancelled {
  background: var(--color-background);
  color: var(--color-text-secondary);
}

/* Chip de rubro/sector de empresa (tecnología, industria, etc.) */
.sector-tag {
  display: inline-block;
  font-size: 11.5px;
  font-weight: 700;
  padding: 3px 10px;
  border-radius: 999px;
  background: var(--color-info-bg);
  color: var(--color-info);
  text-transform: capitalize;
  white-space: nowrap;
}

/* ============================================================
   FORMULARIO DE NUEVA RESERVA
   ============================================================ */
.form-row {
  display: flex;
  gap: 12px;
}

.form-row .form-group {
  flex: 1;
}

.booking-form {
  background: var(--color-background);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 20px;
}

/* ============================================================
   TARJETAS DE RESERVA / SOLICITUD
   ============================================================ */
.booking-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 28px;
}

.booking-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  padding: 14px 16px;
  background: var(--color-surface);
  transition: transform var(--transition-base), box-shadow var(--transition-base);
  animation: fadeInUp 0.4s var(--transition-base) both;
}

.booking-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.booking-card-title {
  font-weight: 700;
  margin-bottom: 3px;
}

.booking-card-meta {
  font-size: 13px;
  color: var(--color-text-secondary);
}

.booking-card-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

.btn-approve,
.btn-reject {
  border: none;
  border-radius: var(--radius-sm);
  padding: 7px 15px;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  font-family: inherit;
  transition: transform var(--transition-fast), opacity var(--transition-fast), background var(--transition-fast);
}

.btn-approve {
  background: var(--color-success);
  color: var(--color-surface);
}

.btn-approve:hover {
  opacity: 0.9;
  transform: translateY(-1px);
}

.btn-reject {
  background: none;
  border: 1px solid var(--color-danger);
  color: var(--color-danger);
}

.btn-reject:hover {
  background: var(--color-danger-bg);
  transform: translateY(-1px);
}

.empty-state {
  font-size: 13px;
  color: var(--color-text-secondary);
  padding: 22px 16px;
  text-align: center;
  background: var(--color-background);
  border: 1px dashed var(--color-border);
  border-radius: var(--radius);
}

/* ============================================================
   AVISO DE "PUENTE" ENTRE PASANTÍAS Y RESERVAS
   ============================================================ */
.bridge-note {
  background: var(--color-info-bg);
  border: 1px solid #C6B8E8;
  border-radius: var(--radius);
  padding: 13px 16px;
  font-size: 13px;
  color: var(--color-text);
  margin-bottom: 18px;
  line-height: 1.5;
}

.bridge-note code {
  background: rgba(109, 74, 174, 0.12);
  padding: 1px 6px;
  border-radius: 4px;
  font-size: 12px;
}

/* ============================================================
   INVENTARIO DE SALONES (panel del admin)
   Tarjetas chicas agrupadas por tipo (espacio / laboratorio /
   equipo), cada una con su ícono y cantidad total.
   ============================================================ */
.inventory-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  gap: 10px;
  margin-bottom: 28px;
}

.inventory-card {
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  padding: 12px 14px;
  background: var(--color-surface);
  transition: transform var(--transition-base), box-shadow var(--transition-base);
  animation: fadeInUp 0.4s var(--transition-base) both;
}

.inventory-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.inventory-card-type {
  font-size: 10.5px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--color-text-secondary);
  margin-bottom: 4px;
}

.inventory-card-name {
  font-weight: 700;
  font-size: 13.5px;
  margin-bottom: 2px;
}

.inventory-card-qty {
  font-size: 12px;
  color: var(--color-accent);
  font-weight: 700;
}

/* ============================================================
   AGENDA PÚBLICA
   ============================================================ */
.agenda-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 14px;
  background: var(--color-surface);
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.agenda-table th {
  text-align: left;
  font-size: 11.5px;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  color: var(--color-text-secondary);
  padding: 10px 14px;
  background: var(--color-background);
  border-bottom: 2px solid var(--color-border);
}

.agenda-table td {
  padding: 12px 14px;
  border-bottom: 1px solid var(--color-border);
}

.agenda-table tbody tr {
  transition: background var(--transition-fast);
}

.agenda-table tbody tr:hover {
  background: var(--color-background);
}

.agenda-page-header {
  max-width: 760px;
  margin: 0 auto;
  padding: 28px 20px 0;
}

.agenda-empty {
  margin-top: 16px;
}

/* ============================================================
   FOOTER INSTITUCIONAL
   Tres columnas (marca, navegación, contacto) + una fila de
   redes sociales + una barra inferior con el crédito legal.
   Fondo con el mismo degradé navy→teal que el hero, para que la
   página quede "enmarcada" entre ambos.
   ============================================================ */
.site-footer {
  background: var(--gradient-brand);
  color: rgba(255, 255, 255, 0.88);
  padding: 52px 24px 0;
}

.site-footer-grid {
  max-width: 980px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1.3fr 1fr 1fr;
  gap: 32px;
  padding-bottom: 36px;
}

.site-footer-brand .logo {
  color: white;
  font-size: 17px;
}

.site-footer-tagline {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 10px;
  line-height: 1.6;
  max-width: 34ch;
}

.site-footer-heading {
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: rgba(255, 255, 255, 0.55);
  margin-bottom: 14px;
}

.site-footer-links {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.site-footer-links a {
  color: rgba(255, 255, 255, 0.85);
  text-decoration: none;
  font-size: 13.5px;
  transition: color var(--transition-fast), padding-left var(--transition-fast);
}

.site-footer-links a:hover {
  color: white;
  padding-left: 4px;
}

.site-footer-contact {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 12px;
  font-size: 13.5px;
}

.site-footer-contact li {
  display: flex;
  align-items: center;
  gap: 10px;
  color: rgba(255, 255, 255, 0.85);
}

.site-footer-contact svg {
  flex-shrink: 0;
  color: #9FE7E3;
}

/* Redes sociales: círculos con ícono, que al pasar el mouse se
   levantan un poco y se iluminan con el color de marca. */
.site-footer-social {
  display: flex;
  gap: 10px;
  margin-top: 16px;
}

.site-footer-social a {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.18);
  color: white;
  transition: transform var(--transition-base), background var(--transition-base), box-shadow var(--transition-base);
}

.site-footer-social a:hover {
  transform: translateY(-3px);
  background: var(--color-accent-light);
  box-shadow: 0 8px 20px rgba(20, 173, 166, 0.35);
}

.site-footer-bottom {
  max-width: 980px;
  margin: 0 auto;
  border-top: 1px solid rgba(255, 255, 255, 0.15);
  padding: 18px 0 26px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
  font-size: 12px;
  color: rgba(255, 255, 255, 0.55);
}

@media (max-width: 720px) {
  .site-footer-grid {
    grid-template-columns: 1fr;
    gap: 28px;
  }

  .site-footer-bottom {
    justify-content: center;
    text-align: center;
  }
}

/* Línea de resumen chica (ej: "2 empresas por aprobar"), en vez
   de una grilla completa de tarjetas grandes como las de reservas. */
.mini-stats-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 18px;
}

.mini-stat {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 12.5px;
  font-weight: 600;
  color: var(--color-text-secondary);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  padding: 6px 12px;
}

/* ============================================================
   TOASTS (reemplazan a alert())
   Se inyectan una sola vez por página (ver asegurarContenedoresUI
   en js/reservas.js) y se apilan en la esquina inferior derecha.
   ============================================================ */
.toast-container {
  position: fixed;
  bottom: 20px;
  right: 20px;
  z-index: 100;
  display: flex;
  flex-direction: column;
  gap: 10px;
  max-width: min(340px, calc(100vw - 40px));
}

.toast {
  display: flex;
  align-items: center;
  gap: 10px;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-left: 4px solid var(--color-accent);
  border-radius: var(--radius-sm);
  padding: 12px 16px;
  font-size: 13.5px;
  font-weight: 600;
  color: var(--color-text);
  box-shadow: var(--shadow-lg);
  animation: fadeInUp 0.3s var(--transition-base) both;
}

.toast-icon {
  flex-shrink: 0;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 800;
  background: var(--color-accent);
  color: white;
}

.toast-success { border-left-color: var(--color-success); }
.toast-success .toast-icon { background: var(--color-success); }
.toast-error { border-left-color: var(--color-danger); }
.toast-error .toast-icon { background: var(--color-danger); }
.toast-info { border-left-color: var(--color-info); }
.toast-info .toast-icon { background: var(--color-info); }

.toast-saliendo {
  animation: fadeIn 0.25s ease reverse both;
}

/* ============================================================
   MODAL DE CONFIRMACIÓN (reemplaza a confirm())
   ============================================================ */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(10, 32, 56, 0.45);
  backdrop-filter: blur(2px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  z-index: 200;
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--transition-fast);
}

.modal-overlay.visible {
  opacity: 1;
  pointer-events: auto;
}

.modal {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 26px 24px;
  width: 100%;
  max-width: 380px;
  box-shadow: var(--shadow-lg);
  transform: translateY(8px) scale(0.98);
  transition: transform var(--transition-base);
}

.modal-overlay.visible .modal {
  transform: translateY(0) scale(1);
}

.modal-title {
  font-size: 16px;
  font-weight: 800;
  color: var(--color-primary);
  margin-bottom: 8px;
}

.modal-text {
  font-size: 13.5px;
  color: var(--color-text-secondary);
  line-height: 1.6;
  margin-bottom: 20px;
  white-space: pre-line;
}

.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
}

/* ============================================================
   PESTAÑAS (usadas en "Mis reservas" del profesor)
   ============================================================ */
.tabs {
  display: flex;
  gap: 6px;
  margin-bottom: 12px;
  flex-wrap: wrap;
}

.tab {
  background: var(--color-background);
  border: 1px solid var(--color-border);
  border-radius: 999px;
  padding: 6px 14px;
  font-size: 12.5px;
  font-weight: 700;
  color: var(--color-text-secondary);
  cursor: pointer;
  transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
}

.tab:hover {
  border-color: var(--color-accent-light);
  color: var(--color-primary);
}

.tab.active {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: white;
}

/* ============================================================
   CHIPS DE FILTRO (cola de reservas del admin, por tipo de salón)
   ============================================================ */
.filter-chips {
  display: flex;
  gap: 6px;
  margin-bottom: 10px;
  flex-wrap: wrap;
}

.filter-chip {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: 999px;
  padding: 5px 13px;
  font-size: 12.5px;
  font-weight: 700;
  color: var(--color-text-secondary);
  cursor: pointer;
  transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
}

.filter-chip:hover {
  border-color: var(--color-accent);
}

.filter-chip.active {
  background: var(--color-accent);
  border-color: var(--color-accent);
  color: white;
}

/* ============================================================
   AVISO DE DISPONIBILIDAD EN VIVO (form de nueva reserva)
   Vacío por defecto; js/reservas.js lo llena a medida que se
   completan salón + fecha + horario, antes de mandar el form.
   ============================================================ */
.availability-hint {
  font-size: 12.5px;
  font-weight: 700;
  margin: -6px 0 16px;
  min-height: 1px;
}

.availability-hint.free {
  color: var(--color-success);
}

.availability-hint.busy {
  color: var(--color-danger);
}

/* ============================================================
   TOGGLE DE VISTA (agenda pública: tabla / por día)
   ============================================================ */
.view-toggle {
  display: inline-flex;
  gap: 4px;
  background: var(--color-background);
  border: 1px solid var(--color-border);
  border-radius: 999px;
  padding: 4px;
  margin-bottom: 14px;
}

.view-toggle-btn {
  background: none;
  border: none;
  border-radius: 999px;
  padding: 6px 14px;
  font-size: 12.5px;
  font-weight: 700;
  color: var(--color-text-secondary);
  cursor: pointer;
  font-family: inherit;
  transition: background var(--transition-fast), color var(--transition-fast);
}

.view-toggle-btn.active {
  background: var(--color-surface);
  color: var(--color-primary);
  box-shadow: var(--shadow-sm);
}

/* ============================================================
   AGENDA PÚBLICA: VISTA "POR DÍA"
   Agrupa las mismas reservas de la tabla en tarjetas, una
   sección por fecha, para escanear la semana de un vistazo.
   ============================================================ */
.agenda-por-dia {
  display: none;
}

.agenda-day-group {
  margin-bottom: 22px;
}

.agenda-day-heading {
  font-size: 12px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--color-accent);
  margin-bottom: 8px;
  padding-bottom: 6px;
  border-bottom: 1px solid var(--color-border);
}

/* ============================================================
   PANEL DEL ADMIN: variantes propias de layout y encabezado
   Nada de esto lo toca JS; son puramente visuales, sobre los
   mismos elementos (#saludo, .section-title, etc.) que ya pinta
   js/reservas.js.
   ============================================================ */
.container-admin {
  max-width: 940px;
}

.admin-header {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 22px 24px;
  margin-bottom: 30px;
  box-shadow: var(--shadow-sm);
  position: relative;
  overflow: hidden;
  animation: fadeInUp 0.4s var(--transition-base) both;
}

.admin-header::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background: var(--gradient-brand);
}

.admin-header-icon {
  flex-shrink: 0;
  width: 46px;
  height: 46px;
  border-radius: 14px;
  background: var(--gradient-brand);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  box-shadow: var(--shadow-sm);
}

.admin-header .greeting {
  margin-bottom: 4px;
}

.admin-header .page-subtitle {
  margin-bottom: 0;
  max-width: 68ch;
}

/* Separador con un pelín de aire y una etiqueta arriba, para que
   cada bloque grande del panel (reservas pendientes, inventario)
   se distinga de un vistazo al hacer scroll. */
.admin-section {
  margin-bottom: 8px;
}

.admin-section + .admin-section {
  margin-top: 12px;
}

/* ============================================================
   HUB DEL ADMIN (dashboard-admin.html)
   Primera pantalla después del login: en vez de todo junto en una
   sola página, dos accesos grandes — Reservas y Pasantías — cada
   uno con su propia página. La franja de color de arriba y el
   ícono cambian según data-variant, para que se note de un
   vistazo que son dos módulos distintos.
   ============================================================ */
.hub-options {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-top: 4px;
}

/* Roles con un solo módulo (profesor, estudiante, empresa): una
   sola tarjeta, angosta, en vez de estirarse a lo ancho de las dos
   columnas que usa el hub del admin. */
.hub-options-single {
  grid-template-columns: 1fr;
}

.hub-options-single .hub-option {
  max-width: 460px;
}

.hub-option {
  display: block;
  text-decoration: none;
  color: inherit;
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 30px 28px;
  position: relative;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
  animation: fadeInUp 0.5s var(--transition-base) both;
}

.hub-option:hover {
  transform: translateY(-5px);
  box-shadow: var(--shadow-lg);
  border-color: var(--color-accent-light);
}

.hub-option::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  transform: scaleX(0);
  transform-origin: left;
  transition: transform var(--transition-base);
}

.hub-option:hover::before {
  transform: scaleX(1);
}

.hub-option[data-variant="reservas"]::before { background: var(--gradient-brand); }
.hub-option[data-variant="pasantias"]::before { background: linear-gradient(135deg, var(--color-info), var(--color-accent)); }

.hub-option-icon {
  width: 54px;
  height: 54px;
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25px;
  margin-bottom: 20px;
  color: white;
  box-shadow: var(--shadow-sm);
}

.hub-option[data-variant="reservas"] .hub-option-icon { background: var(--gradient-brand); }
.hub-option[data-variant="pasantias"] .hub-option-icon { background: linear-gradient(135deg, var(--color-info), var(--color-accent)); }

.hub-option-title {
  font-size: 19px;
  font-weight: 800;
  color: var(--color-primary);
  margin-bottom: 8px;
}

.hub-option-desc {
  font-size: 13.5px;
  color: var(--color-text-secondary);
  line-height: 1.6;
  margin-bottom: 20px;
  max-width: 40ch;
}

.hub-option-teaser {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 12.5px;
  font-weight: 700;
  padding: 5px 12px;
  border-radius: 999px;
  background: var(--color-background);
  border: 1px solid var(--color-border);
  color: var(--color-text-secondary);
  margin-right: 6px;
  margin-bottom: 6px;
}

.hub-option-cta {
  margin-top: 18px;
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 13.5px;
  font-weight: 700;
  color: var(--color-accent);
}

.hub-option-cta svg {
  transition: transform var(--transition-fast);
}

.hub-option:hover .hub-option-cta svg {
  transform: translateX(4px);
}

/* Link de "← Volver al panel" en las páginas de Reservas y
   Pasantías, para no dejar a la persona sin forma de volver al hub. */
.panel-back {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  font-weight: 700;
  color: var(--color-text-secondary);
  text-decoration: none;
  margin-bottom: 18px;
  transition: color var(--transition-fast), gap var(--transition-fast);
}

.panel-back:hover {
  color: var(--color-accent);
  gap: 9px;
}

/* Directorio de empresas (empresas registradas): tabla compacta
   de tarjetas, reutilizando .booking-card pero con el chip de
   estado a la derecha en vez de botones de acción. */
.company-directory {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 28px;
}

/* ============================================================
   RESPONSIVE: en pantallas chicas (celular), las tarjetas de
   métricas y de rol pasan de estar en fila a apilarse en columna,
   y los formularios/tarjetas de reserva hacen lo mismo.
   ============================================================ */
@media (max-width: 720px) {
  .role-cards-three {
    grid-template-columns: repeat(2, 1fr);
  }

  .hub-options {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 480px) {
  .stats-grid {
    grid-template-columns: 1fr;
  }

  .role-cards,
  .role-cards-three {
    grid-template-columns: 1fr;
    margin-top: -20px;
  }

  .hero {
    padding: 56px 20px 48px;
  }

  .hero-title {
    font-size: 25px;
  }

  .hero-actions {
    flex-direction: column;
  }

  .form-row {
    flex-direction: column;
    gap: 0;
  }

  .booking-card {
    flex-direction: column;
    align-items: flex-start;
  }

  .booking-card-actions {
    width: 100%;
  }

  .agenda-table {
    font-size: 13px;
  }

  .navbar-left {
    gap: 14px;
  }

  .toast-container {
    left: 12px;
    right: 12px;
    bottom: 12px;
    max-width: none;
  }

  .admin-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 18px 18px;
  }
}

/* ============================================================
   ANCLAS DE SECCIÓN (links del menú que llevan a una sección
   de la misma página, en estudiante / profesor / empresa)
   El navbar es sticky (position: sticky, top: 0), así que sin
   esto el título de la sección quedaría justo debajo del menú y
   tapado. scroll-margin-top le reserva ese espacio al saltar.
   ============================================================ */
[id^="seccion-"] {
  scroll-margin-top: 84px;
}

