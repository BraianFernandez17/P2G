          }
          empresasPendientes = empresasPendientes.filter((e) => e.id !== empresaId);
          if (accion === "approve") {
            empresasActivas.push({ id: empresa.id, razonSocial: empresa.razonSocial, sector: empresa.sector });
          }
          pintarColaDeEmpresas();
          pintarResumenPasantias();
          pintarEmpresasRegistradas();
          mostrarToast(
            accion === "approve"
              ? `${empresa.razonSocial} aprobada. Ya puede publicar pasantías.`
