/* ============================================================
   FUNCIONES DE AYUDA, REUTILIZABLES EN CUALQUIER FORMULARIO
   ============================================================ */

// Muestra un mensaje de error debajo de un campo puntual.
// idCampo tiene que coincidir con el id del <p class="form-error" id="...">
function mostrarError(idCampo, mensaje) {
  const errorEl = document.getElementById(`${idCampo}-error`);
  if (!errorEl) return;
  errorEl.textContent = mensaje;
  errorEl.classList.add("visible");
}

// Limpia todos los errores de un formulario antes de revalidar,
// para no dejar mensajes viejos de un intento anterior.
function limpiarErrores(formulario) {
  formulario.querySelectorAll(".form-error").forEach((el) => {
    el.textContent = "";
    el.classList.remove("visible");
  });
}

// Validación bien básica: solo chequea que el campo no esté vacío
// y, si es de tipo email, que tenga al menos un "@".
// El backend SIEMPRE vuelve a validar todo esto de nuevo del lado
// del servidor: nunca hay que confiar solo en la validación del
// navegador, porque alguien podría saltearse el formulario.
function validarCampo(input) {
  const valor = input.value.trim();

  if (input.required && valor === "") {
    mostrarError(input.id, "Este campo es obligatorio");
    return false;
  }

  if (input.type === "email" && !valor.includes("@")) {
    mostrarError(input.id, "Ingresá un email válido");
    return false;
  }

  if (input.type === "password" && valor.length < 6) {
    mostrarError(input.id, "La contraseña debe tener al menos 6 caracteres");
    return false;
  }

  return true;
}

// Recorre todos los inputs/selects de un formulario y valida cada uno.
// Devuelve true solo si TODOS pasaron la validación.
function validarFormulario(formulario) {
  limpiarErrores(formulario);

  const campos = formulario.querySelectorAll(".form-input, .form-select");
  let esValido = true;

  campos.forEach((campo) => {
    const campoValido = validarCampo(campo);
    if (!campoValido) esValido = false;
  });

  return esValido;
}

/* ============================================================
   INICIO DE SESIÓN
   ============================================================ */
const formularioLogin = document.getElementById("login-form");

if (formularioLogin) {
  formularioLogin.addEventListener("submit", async (evento) => {
    // Frenamos el comportamiento por defecto del navegador
    // (que sería recargar la página), porque lo vamos a manejar
    // nosotros con JS.
    evento.preventDefault();

    if (!validarFormulario(formularioLogin)) return;

    const email = formularioLogin.querySelector("#email").value.trim();
    const password = formularioLogin.querySelector("#password").value;

    try {
      const respuesta = await fetch("/api/auth/login", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, password }),
      });
      const datos = await respuesta.json();

      if (!respuesta.ok) {
        mostrarError(
          "email",
          datos.error || "No encontramos una cuenta con ese email y esa contraseña."
        );
        return;
      }

      guardarSesion(datos);
      window.location.href = PANEL_POR_ROL[datos.role];
    } catch {
      mostrarError("email", "No pudimos conectar con el servidor. ¿Está corriendo?");
    }
  });
}

