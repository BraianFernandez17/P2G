/* ============================================================
   PANTALLA: agenda-publica.html
   Solo muestra reservas ya aprobadas y a futuro: es justamente
   lo que la letra pide para el perfil Alumno/Público, sin login.

   Mejora: además de la tabla original, se puede ver la misma
   información agrupada "por día", más fácil de escanear cuando
   hay varias reservas seguidas. Un toggle alterna entre las dos
   vistas; ambas se arman con los mismos datos.
   ============================================================ */
let vistaAgendaPublica = "tabla"; // "tabla" | "dia"

function asegurarToggleVistaAgenda() {
  const tablaEl = document.querySelector(".agenda-table");
  if (!tablaEl || document.getElementById("toggle-vista-agenda")) return;

  const toggleEl = document.createElement("div");
  toggleEl.id = "toggle-vista-agenda";
  toggleEl.className = "view-toggle";
  toggleEl.innerHTML = `
    <button type="button" class="view-toggle-btn active" data-vista="tabla">☰ Tabla</button>
    <button type="button" class="view-toggle-btn" data-vista="dia">📅 Por día</button>
  `;
  tablaEl.parentElement.insertBefore(toggleEl, tablaEl);

  const porDiaEl = document.createElement("div");
  porDiaEl.id = "agenda-por-dia";
  porDiaEl.className = "agenda-por-dia";
  tablaEl.parentElement.insertBefore(porDiaEl, tablaEl.nextSibling);

  toggleEl.querySelectorAll("button[data-vista]").forEach((boton) => {
    boton.addEventListener("click", () => {
      vistaAgendaPublica = boton.dataset.vista;
      toggleEl.querySelectorAll("button").forEach((b) => b.classList.toggle("active", b === boton));
      aplicarVistaAgenda();
    });
  });
}

function aplicarVistaAgenda() {
  const tablaEl = document.querySelector(".agenda-table");
  const porDiaEl = document.getElementById("agenda-por-dia");
  if (!tablaEl || !porDiaEl) return;
  tablaEl.style.display = vistaAgendaPublica === "tabla" ? "table" : "none";
  porDiaEl.style.display = vistaAgendaPublica === "dia" ? "block" : "none";
}

function pintarAgendaPublica() {
  const cuerpoEl = document.getElementById("cuerpo-tabla-agenda");
  const vaciaEl = document.getElementById("agenda-vacia");
  if (!cuerpoEl) return;

  asegurarToggleVistaAgenda();
  const porDiaEl = document.getElementById("agenda-por-dia");
  const tablaEl = document.querySelector(".agenda-table");

  const ahora = new Date();
  const proximas = reservas
    .filter((r) => r.estado === "approved" && new Date(r.desde) >= ahora)
    .sort((a, b) => new Date(a.desde) - new Date(b.desde));

  if (proximas.length === 0) {
    cuerpoEl.innerHTML = "";
    if (porDiaEl) porDiaEl.innerHTML = "";
    if (vaciaEl) vaciaEl.style.display = "block";
    if (tablaEl) tablaEl.style.display = "none";
    if (porDiaEl) porDiaEl.style.display = "none";
    return;
  }

  if (vaciaEl) vaciaEl.style.display = "none";

  // Vista tabla (la original).
  cuerpoEl.innerHTML = proximas
    .map(
      (reserva) => `
      <tr>
        <td>${formatearRango(reserva.desde, reserva.hasta)}</td>
        <td>${nombreDelSalon(reserva.salonId)}</td>
        <td>${reserva.motivo}</td>
        <td>${reserva.pedidaPor}</td>
      </tr>
    `
    )
    .join("");

  // Vista "por día": mismas reservas, agrupadas por fecha.
  if (porDiaEl) {
    const grupos = {};
    proximas.forEach((reserva) => {
      const fecha = reserva.desde.slice(0, 10);
      if (!grupos[fecha]) grupos[fecha] = [];
      grupos[fecha].push(reserva);
    });

    const etiquetasDia = ["Domingo", "Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado"];

    porDiaEl.innerHTML = Object.keys(grupos)
      .map((fecha) => {
        const d = new Date(`${fecha}T00:00:00`);
        const pad = (n) => String(n).padStart(2, "0");
        const etiquetaFecha = `${etiquetasDia[d.getDay()]} ${pad(d.getDate())}/${pad(d.getMonth() + 1)}`;

        const tarjetas = grupos[fecha]
          .map(
            (reserva) => `
            <div class="booking-card">
              <div>
                <p class="booking-card-title">${nombreDelSalon(reserva.salonId)} · ${reserva.motivo}</p>
                <p class="booking-card-meta">${formatearRango(reserva.desde, reserva.hasta)} · ${reserva.pedidaPor}</p>
              </div>
            </div>
          `
          )
          .join("");

        return `
          <div class="agenda-day-group">
            <p class="agenda-day-heading">${etiquetaFecha}</p>
            <div class="booking-list">${tarjetas}</div>
          </div>
        `;
      })
      .join("");
  }

  aplicarVistaAgenda();
}

/* ============================================================
   SALUDO (compartido por dashboard-profesor.html y
   dashboard-admin.html: cada uno tiene su propio #saludo)
   ============================================================ */
function pintarSaludo() {
  const saludoEl = document.getElementById("saludo");
  if (!saludoEl) return;

  const sesion = typeof obtenerSesion === "function" ? obtenerSesion() : null;
  // El hub (dashboard-admin.html) tiene esta grilla de opciones; las
  // subpáginas (reservas / pasantías) no, así que con esto alcanza
  // para distinguir un saludo más corto del encabezado de cada módulo.
  const esHub = !!document.getElementById("hub-opciones");

  if (sesion && sesion.role === "professor") {
    saludoEl.textContent = `Hola, Prof. ${profesorActual.apellido}`;
  } else if (sesion && sesion.role === "admin") {
    saludoEl.textContent = esHub ? `Hola, ${sesion.name}` : `Panel del administrador — ${sesion.name}`;
  } else {
    // Mock, para cuando se abre el archivo directo sin login.
    saludoEl.textContent = esHub ? "Hola, Admin del Polo" : `Hola, Prof. ${profesorActual.apellido}`;
  }
}

// Números chicos que se muestran dentro de cada tarjeta del hub
// (dashboard-admin.html), para que la persona sepa qué la espera
// antes de entrar a Reservas o a Pasantías. El hub del admin es el
// único con DOS tarjetas (#teaser-reservas y #teaser-pasantias a la
// vez), así que si falta cualquiera de las dos no es esta pantalla
// (es el hub del profesor, que solo tiene Reservas).
function pintarHubAdmin() {
  const teaserReservas = document.getElementById("teaser-reservas");
  const teaserPasantias = document.getElementById("teaser-pasantias");
  if (!teaserReservas || !teaserPasantias) return;

  const reservasPendientes = reservas.filter((r) => r.estado === "pending").length;
  const empresasPorAprobar = empresasPendientes.length;
  const alumnosConPostulacion = new Set(postulacionesAdmin.map((p) => p.alumno)).size;

  teaserReservas.innerHTML = `
    <span class="hub-option-teaser">🏛️ ${salones.length} salones y equipos</span>
    <span class="hub-option-teaser">⏳ ${reservasPendientes} pendientes</span>
  `;

  teaserPasantias.innerHTML = `
    <span class="hub-option-teaser">🏢 ${empresasPorAprobar} empresas por aprobar</span>
    <span class="hub-option-teaser">🎓 ${alumnosConPostulacion} alumnos postulados</span>
  `;
}

// Mismo teaser que arriba, pero para el hub del profesor
// (dashboard-profesor.html), que solo tiene la tarjeta de Reservas
// con SUS propias reservas (esMia), no las de todo el Polo.
function pintarHubProfesor() {
  const teaserReservas = document.getElementById("teaser-reservas");
  const teaserPasantias = document.getElementById("teaser-pasantias");
  if (!teaserReservas || teaserPasantias) return;

  const misReservasPendientes = reservas.filter((r) => r.esMia && r.estado === "pending").length;

  teaserReservas.innerHTML = `
    <span class="hub-option-teaser">🏛️ ${salones.length} salones y equipos</span>
    <span class="hub-option-teaser">⏳ ${misReservasPendientes} de mis reservas pendientes</span>
  `;
}

/* ============================================================
   PUNTO DE ENTRADA
   Cada página solo tiene los elementos que le corresponden, por
   eso cada función de render arranca revisando si su elemento
   existe (return temprano) antes de intentar tocar el DOM.
   ============================================================ */
document.addEventListener("DOMContentLoaded", async () => {
  pintarSaludo();

  await cargarDatosReservas();

  const selectSalon = document.getElementById("salon");
  if (selectSalon) pintarOpcionesDeSalones(selectSalon);

  pintarHubAdmin();
  pintarHubProfesor();
  pintarMisReservas();
  pintarEstadisticasReservas();
  pintarInventarioDeSalones();
  pintarColaDeReservas();
  pintarColaDeEmpresas();
  pintarEntrevistasPorAgendar();
  pintarResumenPasantias();
  pintarEmpresasRegistradas();
  pintarPostulacionesAdmin();
  pintarAgendaPublica();

  const formNuevaReserva = document.getElementById("form-nueva-reserva");
  if (formNuevaReserva) {
    formNuevaReserva.addEventListener("submit", manejarNuevaReserva);
    inicializarChequeoDisponibilidad();
  }
});
