/* ============================================================
   VARIABLES DE COLOR Y TOKENS DE DISEÑO
   Las definimos una sola vez acá arriba, así si el día de mañana
   cambia la identidad visual, se cambia en un solo lugar y no en
   cada regla. Se mantiene la base navy + teal del Polo, sumando
   variantes claras/oscuras para poder hacer degradés y estados
   hover sin inventar colores nuevos sueltos por el CSS.
   ============================================================ */
:root {
  --color-primary: #12314F;        /* Navy: headers, navegación, botones principales */
  --color-primary-light: #26517A;
  --color-primary-dark: #0A2038;
  --color-accent: #0E8388;         /* Teal: acciones secundarias, estados activos */
  --color-accent-light: #14ADA6;
  --color-success: #2E7D32;
  --color-success-bg: #E8F5E9;
  --color-warning: #ED6C02;
  --color-warning-bg: #FFF3E0;
  --color-danger: #C62828;
  --color-danger-bg: #FFEBEE;
  --color-info: #6D4AAE;
  --color-info-bg: #F0EBFB;
  --color-background: #F5F7FA;     /* Fondo general */
  --color-surface: #FFFFFF;        /* Fondo de tarjetas */
  --color-text: #1F2937;           /* Texto principal */
  --color-text-secondary: #667085; /* Texto secundario / metadatos */
  --color-border: #E4E8EE;
  --radius: 14px;
  --radius-sm: 10px;
  --radius-lg: 20px;
  --shadow-sm: 0 1px 2px rgba(18, 49, 79, 0.05), 0 1px 3px rgba(18, 49, 79, 0.04);
  --shadow-md: 0 6px 20px rgba(18, 49, 79, 0.08);
  --shadow-lg: 0 16px 40px rgba(18, 49, 79, 0.12);
  --gradient-brand: linear-gradient(135deg, #0F2A45 0%, #164464 40%, #0E8388 120%);
  --transition-fast: 0.18s cubic-bezier(0.4, 0, 0.2, 1);
  --transition-base: 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

/* Reset básico: sacamos los márgenes por defecto que pone cada navegador,
   para empezar de cero y que el diseño se vea igual en todos lados. */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  color: var(--color-text);
  background: var(--color-surface);
  -webkit-font-smoothing: antialiased;
}

/* Foco visible y consistente para navegación por teclado, en vez
   de depender del outline por defecto (que varía por navegador). */
a:focus-visible,
button:focus-visible,
input:focus-visible,
select:focus-visible {
  outline: 2px solid var(--color-accent-light);
  outline-offset: 2px;
}

/* Respeta a quien eligió "reducir movimiento" en su sistema
   operativo: le apagamos las animaciones y transiciones. */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
    scroll-behavior: auto !important;
  }
}

/* ------------------------------------------------------------
   ANIMACIONES REUTILIZABLES
   ------------------------------------------------------------ */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(14px) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes pulseDot {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.35; }
}

@keyframes floatSlow {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-16px) scale(1.03); }
}

.fade-in-up {
  animation: fadeInUp 0.5s var(--transition-base) both;
}

/* Stagger: cada tarjeta de una grilla entra un pelín después que la
   anterior, en vez de todas de golpe. Se aplica a .stat-card,
   .internship-card, .booking-card, .role-card e .inventory-card. */
.stats-grid > *:nth-child(1),
.internship-list > *:nth-child(1),
.booking-list > *:nth-child(1),
.role-cards > *:nth-child(1),
.inventory-grid > *:nth-child(1) { animation-delay: 0.02s; }
.stats-grid > *:nth-child(2),
.internship-list > *:nth-child(2),
.booking-list > *:nth-child(2),
.role-cards > *:nth-child(2),
.inventory-grid > *:nth-child(2) { animation-delay: 0.08s; }
.stats-grid > *:nth-child(3),
.internship-list > *:nth-child(3),
.booking-list > *:nth-child(3),
.role-cards > *:nth-child(3),
.inventory-grid > *:nth-child(3) { animation-delay: 0.14s; }
.stats-grid > *:nth-child(4),
.internship-list > *:nth-child(4),
.booking-list > *:nth-child(4),
.inventory-grid > *:nth-child(4) { animation-delay: 0.2s; }
.stats-grid > *:nth-child(5),
.internship-list > *:nth-child(5),
.booking-list > *:nth-child(5),
.inventory-grid > *:nth-child(5) { animation-delay: 0.26s; }
.booking-list > *:nth-child(n+6),
.inventory-grid > *:nth-child(n+6) { animation-delay: 0.3s; }

