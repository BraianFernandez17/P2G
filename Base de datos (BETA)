function pintarColaDeReservas() {
  const listaEl = document.getElementById("lista-reservas-admin");
  if (!listaEl) return;

  pintarFiltrosColaReservas();

  let pendientes = reservas.filter((r) => r.estado === "pending");
  if (filtroTipoAdmin !== "todos") {
    pendientes = pendientes.filter((r) => {
      const salon = salones.find((s) => s.id === r.salonId);
      return salon && salon.tipo === filtroTipoAdmin;
    });
  }
  pendientes = [...pendientes].sort((a, b) => new Date(a.desde) - new Date(b.desde));

  if (pendientes.length === 0) {
    listaEl.innerHTML = `<p class="empty-state">No hay reservas pendientes de aprobar${
      filtroTipoAdmin === "todos" ? "" : " en esta categoría"
    }.</p>`;
    return;
  }

  listaEl.innerHTML = pendientes
    .map(
      (reserva) => `
      <div class="booking-card">
        <div>
          <p class="booking-card-title">${reserva.motivo}</p>
          <p class="booking-card-meta">
            ${nombreDelSalon(reserva.salonId)} · ${formatearRango(reserva.desde, reserva.hasta)}
            · Pedida por ${reserva.pedidaPor}
          </p>
        </div>
        <div class="booking-card-actions">
          <button class="btn-approve" data-reserva-id="${reserva.id}" data-accion="approve">Aprobar</button>
          <button class="btn-reject" data-reserva-id="${reserva.id}" data-accion="reject">Rechazar</button>
        </div>
      </div>
    `
    )
    .join("");

  listaEl.querySelectorAll("button[data-reserva-id]").forEach((boton) => {
    boton.addEventListener("click", () => {
      const reservaId = boton.dataset.reservaId;
      const accion = boton.dataset.accion;
      const reserva = reservas.find((r) => r.id === reservaId);

      const aplicarDecision = async () => {
        const nuevoEstado = accion === "approve" ? "approved" : "rejected";
        try {
          const respuesta = await fetch(`/api/bookings/${reserva.id}`, {
            method: "PATCH",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ status: nuevoEstado }),
          });
          if (!respuesta.ok) {
            mostrarToast("No pudimos actualizar la reserva.", "error");
            return;
          }
          reserva.estado = nuevoEstado;
          pintarColaDeReservas();
          pintarAgendaPublica();
          pintarEstadisticasReservas();
          pintarInventarioDeSalones();
          mostrarToast(
            accion === "approve" ? "Reserva aprobada." : "Reserva rechazada.",
            accion === "approve" ? "success" : "info"
          );
        } catch {
          mostrarToast("No pudimos conectar con el servidor.", "error");
        }
      };

      if (accion === "reject") {
        pedirConfirmacion(
          "Rechazar reserva",
          `¿Rechazar el pedido de "${reserva.motivo}" para ${nombreDelSalon(reserva.salonId)}?`,
          aplicarDecision
        );
      } else {
        aplicarDecision();
      }
    });
  });
}

function pintarColaDeEmpresas() {
  const listaEl = document.getElementById("lista-empresas-admin");
